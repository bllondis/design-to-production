---
/**
 * Button: a link styled as an action.
 *
 * variant  "light"  white fill, for dark surfaces (default)
 *          "dark"   black fill, for light surfaces
 *          "text"   underlined muted link, for secondary actions
 * size     "m" (default) | "s"
 * icon     glyph after the label: "↗" external/onward (default), "↓" download, "" none
 */
interface Props {
  href: string;
  variant?: "light" | "dark" | "text";
  size?: "m" | "s";
  icon?: string;
  external?: boolean;
}

const { href, variant = "light", size = "m", icon = "↗", external = false } = Astro.props;
const target = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a class:list={["button", `button--${variant}`, `button--${size}`]} href={href} {...target}>
  <slot />{icon && <span aria-hidden="true">{icon}</span>}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-strong);
    text-decoration: none;
    transition:
      background var(--motion-duration-hover) var(--motion-easing-standard),
      color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  .button--m {
    min-height: 3.25rem;
    gap: 1.1rem;
    padding: 0 1.4rem;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
  }

  .button--s {
    min-height: 3rem;
    gap: 0.9rem;
    padding: 0 1.3rem;
    font-size: var(--font-size-body-s);
  }

  .button--light {
    border: 1px solid var(--color-surface-inverse);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .button--light:hover {
    background: var(--color-surface-page);
    color: var(--color-text-primary);
  }

  .button--dark {
    border: 1px solid var(--color-surface-page);
    background: var(--color-surface-page);
    color: var(--color-text-primary);
  }

  .button--dark:hover {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .button--text {
    display: inline-block;
    min-height: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: var(--font-weight-regular);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .button--text span {
    margin-left: 0.3em;
  }

  .button--text:hover {
    color: var(--color-text-primary);
  }
</style>
