---
/**
 * SkillGrid: a labelled grid of skills. Three columns wide, two on medium screens, a list on narrow ones.
 * Cells invert to the light surface on hover.
 */
interface Props {
  label?: string;
  items: string[];
}

const { label = "What I bring", items } = Astro.props;
---

<div class="skills">
  <p class="skills-label text-label-l">{label}</p>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .skills-label {
    margin: 0;
    padding: 1.6rem var(--space-inset-inline);
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-muted);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: flex;
    min-height: clamp(8rem, 11vw, 10.5rem);
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2.6vw, 2.4rem) var(--space-inset-inline) clamp(1.5rem, 2.6vw, 2.4rem);
    font-size: clamp(1.05rem, 1.45vw, 1.35rem);
    letter-spacing: var(--font-tracking-body);
    line-height: var(--font-line-height-compact);
    transition:
      background var(--motion-duration-hover) var(--motion-easing-standard),
      color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  li:not(:nth-child(3n)) {
    border-right: 1px solid var(--color-border-default);
  }

  li:nth-child(n + 4) {
    border-top: 1px solid var(--color-border-default);
  }

  li:hover {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  @media (max-width: 980px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li,
    li:not(:nth-child(3n)) {
      border-right: 0;
    }

    li:nth-child(odd) {
      border-right: 1px solid var(--color-border-default);
    }

    li:nth-child(n + 3) {
      border-top: 1px solid var(--color-border-default);
    }
  }

  @media (max-width: 680px) {
    .skills-label {
      padding: 1.3rem var(--space-m);
    }

    ul {
      grid-template-columns: 1fr;
    }

    li,
    li:nth-child(odd) {
      min-height: 0;
      flex-direction: row;
      padding: 1.15rem var(--space-m);
      border-right: 0;
    }

    li:nth-child(n + 2) {
      border-top: 1px solid var(--color-border-default);
    }
  }
</style>
