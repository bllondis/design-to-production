---
/**
 * AsciiVisual: a project screenshot redrawn as a coloured glyph mosaic.
 * It fills its container; the parent decides size and borders.
 *
 * src      screenshot to sample
 * focus    "x y" from 0 to 1, which part of the image to keep when cropping (default "0.5 0.5")
 * caption  small mono label in the bottom-left corner
 */
interface Props {
  src: string;
  focus?: string;
  caption?: string;
}

const { src, focus = "0.5 0.5", caption } = Astro.props;
---

<figure class="ascii">
  <canvas data-ascii={src} data-ascii-focus={focus} aria-hidden="true"></canvas>
  {caption && <figcaption class="text-label-s">{caption}</figcaption>}
</figure>

<script>
  import "../../scripts/ascii-visual.js";
</script>

<style>
  .ascii {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-page);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 0.55rem var(--space-xs);
    border-top: 1px solid var(--color-border-default);
    border-right: 1px solid var(--color-border-default);
    background: var(--color-surface-page);
    color: var(--color-text-muted);
    font-size: 0.55rem;
  }
</style>
