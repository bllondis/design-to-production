---
import { person, primaryNav } from "../../data/site.js";
---

<header class="header">
  <a class="identity" href="/#top" aria-label={`${person.name}, home`}>
    <span>{person.name}</span>
    <small class="text-label-s">{person.role}</small>
  </a>
  <nav class="nav" aria-label="Primary navigation">
    {primaryNav.map((item) => <a class="text-label-m" href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style>
  .header {
    position: absolute;
    top: var(--space-page);
    left: var(--space-page);
    display: flex;
    width: calc(100% - (2 * var(--space-page)));
    min-height: var(--layout-header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: 0 1.55rem;
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-header);
    color: var(--color-text-primary);
  }

  .identity {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    font-size: clamp(1.1rem, 2vw, 1.65rem);
    letter-spacing: var(--font-tracking-tight);
    text-decoration: none;
  }

  .identity small {
    color: var(--color-text-muted);
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 2rem);
  }

  .nav a {
    position: relative;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--motion-duration-fade) var(--motion-easing-standard);
  }

  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 980px) {
    .identity small {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .header {
      gap: var(--space-s);
      padding: 0 0.85rem;
    }

    .identity {
      font-size: var(--font-size-body-s);
    }

    .nav {
      gap: 0.85rem;
    }

    .nav a:nth-child(2),
    .nav a:nth-child(3) {
      display: none;
    }

    .nav a {
      font-size: 0.58rem;
    }
  }
</style>
