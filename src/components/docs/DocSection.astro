---
/**
 * DocSection: a titled chapter of the /system docs, built from the same Frame rows as the site.
 */
import FrameRow from "../layout/FrameRow.astro";
import Heading from "../ui/Heading.astro";

interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, label, title, intro } = Astro.props;
---

<section class="doc-section" id={id} aria-labelledby={`${id}-title`}>
  <FrameRow as="header">
    <div class="doc-head">
      <p class="text-label-l">{label}</p>
      <Heading id={`${id}-title`} size="display-4" measure={18}>{title}</Heading>
      {intro && <p class="doc-intro">{intro}</p>}
    </div>
  </FrameRow>
  <slot />
</section>

<style>
  .doc-section {
    margin-top: var(--space-section);
  }

  .doc-head {
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .doc-head > .text-label-l {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .doc-intro {
    max-width: 42rem;
    margin: var(--space-l) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-m);
    line-height: var(--font-line-height-relaxed);
  }

  @media (max-width: 680px) {
    .doc-head {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
