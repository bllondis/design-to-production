---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocSection from "../components/docs/DocSection.astro";
import Specimen from "../components/docs/Specimen.astro";
import Frame from "../components/layout/Frame.astro";
import FrameRow from "../components/layout/FrameRow.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import { AsciiVisual, Button, Heading, PixelDoor, SignalField, SkillGrid, Tile } from "../components/ui";
import tokens from "../data/tokens.json";

const byPrefix = (...path) => tokens.filter((token) => path.every((part, index) => token.path[index] === part));
const cssVar = (token) => `--${token.name}`;

const primitiveColors = tokens.filter((token) => token.tier === "primitive" && token.type === "color");
const semanticColorGroups = ["surface", "text", "border", "accent", "light"].map((group) => ({
  group,
  tokens: byPrefix("color", group),
}));
const typeScale = byPrefix("font", "size");
const spacing = byPrefix("space");
const layout = byPrefix("layout");
const durations = byPrefix("motion", "duration");
const easings = byPrefix("motion", "easing");
const tracking = byPrefix("font", "tracking");
const lineHeights = byPrefix("font", "line-height");

const sections = [
  ["tokens", "Tokens"],
  ["color", "Colour"],
  ["type", "Typography"],
  ["space", "Space & layout"],
  ["motion", "Motion"],
  ["components", "Components"],
];
---

<BaseLayout
  title="Design System | Tetiana Dovgalenko"
  description="The tokens, components and patterns this portfolio is built from."
  path="/system/"
>
  <SiteHeader />
  <main id="main" class="system">
    <Frame aria-labelledby="system-title">
      <FrameRow divider="none">
        <div class="intro">
          <p class="text-label-l">Design system / v1</p>
          <Heading
            client:load
            as="h1"
            id="system-title"
            size="display-2"
            measure={11}
            text="The system behind this site."
          />
          <p class="intro-lead">
            Every colour, size and motion on the portfolio comes from one set of tokens, and every block is a component
            with named variants. This page is built from those same components, so it can't drift from the site.
          </p>
          <nav class="toc text-label-m" aria-label="On this page">
            {sections.map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
          <div class="intro-actions">
            <Button href="/storybook/">Open Storybook</Button>
          </div>
        </div>
      </FrameRow>

      <DocSection
        id="tokens"
        label="01 / Foundations"
        title="Tokens in two tiers."
        intro="Primitives hold raw values. Semantic tokens say what a value is for, and only they are used in components. Changing a primitive updates every role that points to it."
      >
        <FrameRow>
          <ol class="pipeline">
            <li>
              <span class="text-label-s">Source</span>
              <strong>tokens/*.tokens.json</strong>
              <small>W3C DTCG format</small>
            </li>
            <li>
              <span class="text-label-s">Build</span>
              <strong>Style Dictionary</strong>
              <small>npm run tokens</small>
            </li>
            <li>
              <span class="text-label-s">Code</span>
              <strong>src/styles/tokens.css</strong>
              <small>CSS custom properties</small>
            </li>
            <li>
              <span class="text-label-s">Design</span>
              <strong>Figma Variables</strong>
              <small>same source, next step</small>
            </li>
          </ol>
        </FrameRow>
      </DocSection>

      <DocSection id="color" label="02 / Colour" title="Ink, paper, one accent and warm light.">
        <FrameRow>
          <div class="swatches">
            {primitiveColors.map((token) => (
              <div class="swatch">
                <span class="swatch-chip" style={`background: var(${cssVar(token)})`} />
                <span class="text-label-s">{token.path.slice(1).join("-")}</span>
                <code>{token.value}</code>
              </div>
            ))}
          </div>
        </FrameRow>
        {semanticColorGroups.map(({ group, tokens: groupTokens }) => (
          <FrameRow>
            <div class="token-table">
              <p class="text-label-m token-group">{group}</p>
              {groupTokens.map((token) => (
                <div class="token-line">
                  <span class="token-preview" style={`background: var(${cssVar(token)})`} />
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.reference ?? token.value}</span>
                  <span class="token-note">{token.description}</span>
                </div>
              ))}
            </div>
          </FrameRow>
        ))}
      </DocSection>

      <DocSection
        id="type"
        label="03 / Typography"
        title="Urbanist for voice, mono for labels, pixels for play."
        intro="Fluid sizes scale with the viewport between a floor and a ceiling. Headings pick a size by role, not by tag."
      >
        {typeScale.map((token) => (
          <FrameRow>
            <div class="type-row">
              <div class="type-meta">
                <code>{cssVar(token)}</code>
                <span class="token-note">{token.description ?? token.value}</span>
              </div>
              <p
                class:list={["type-sample", { "text-label-l": token.path[2].startsWith("label") }]}
                style={`font-size: var(${cssVar(token)})`}
              >
                {token.path[2].startsWith("label")
                  ? "Capability / 01"
                  : token.path[2].startsWith("display")
                    ? "Calm systems"
                    : "Calm interfaces for complex systems"}
              </p>
            </div>
          </FrameRow>
        ))}
        <FrameRow>
          <div class="token-table token-table--split">
            <div>
              <p class="text-label-m token-group">Tracking</p>
              {tracking.map((token) => (
                <div class="token-line token-line--plain">
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.value}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-label-m token-group">Line height</p>
              {lineHeights.map((token) => (
                <div class="token-line token-line--plain">
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.value}</span>
                </div>
              ))}
            </div>
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="space"
        label="04 / Space & layout"
        title="A fixed step scale, plus fluid insets for the frame."
        intro="Breakpoints: medium at 980px (gutters collapse, two columns stack) and narrow at 680px (one column, page padding drops to 0.75rem)."
      >
        <FrameRow>
          <div class="token-table">
            {spacing.map((token) => (
              <div class="token-line token-line--space">
                <span class="space-bar" style={`width: var(${cssVar(token)})`} />
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.value}</span>
                <span class="token-note">{token.description}</span>
              </div>
            ))}
            {layout.map((token) => (
              <div class="token-line token-line--plain">
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.value}</span>
                <span class="token-note">{token.description}</span>
              </div>
            ))}
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="motion"
        label="05 / Motion"
        title="Quick to respond, slow to settle."
        intro="All motion stops under prefers-reduced-motion: canvases render a still frame and doors don't flap."
      >
        <FrameRow>
          <div class="token-table">
            {[...durations, ...easings].map((token) => (
              <div class="token-line token-line--plain">
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.reference ?? token.value}</span>
                <span class="token-note">{token.value}</span>
              </div>
            ))}
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="components"
        label="06 / Components"
        title="Every block, with its variants and states."
        intro="Building blocks are React + TypeScript components in src/components/ui, each with its CSS module, Storybook story and tests. Astro composes them into pages: layout (Frame, FrameRow, RuledSection) and sections (CapabilityBlock and friends). Interactive blocks hydrate only when they scroll into view."
      >
        <Specimen
          name="Button"
          file="ui/Button/Button.tsx"
          usage={`<Button href="/Cases/timeflow.html">See it in Timeflow</Button>\n<Button href="mailto:…" variant="dark" size="s">Get in touch</Button>\n<Button href="https://…" variant="text" external>Open live product</Button>`}
        >
          <ul slot="notes">
            <li>
              <code>variant</code>: light (on dark), dark (on light), text
            </li>
            <li>
              <code>size</code>: m, s
            </li>
            <li>
              <code>icon</code>: ↗ (default), ↓, or none
            </li>
            <li>Hover inverts the fill.</li>
          </ul>
          <Button href="#components">Light, m</Button>
          <Button href="#components" variant="text">
            Text link
          </Button>
        </Specimen>
        <Specimen name="Button on light" file="ui/Button/Button.tsx" surface="light">
          <p slot="notes">The dark variant is for inverse bands such as the contact section.</p>
          <Button href="#components" variant="dark" size="s">
            Dark, s
          </Button>
          <Button href="#components" variant="dark" icon="↓">
            Download CV
          </Button>
        </Specimen>

        <Specimen
          name="Heading"
          file="ui/Heading/Heading.tsx"
          usage={`<Heading as="h3" size="display-4" measure={16} text="Design Systems" />`}
        >
          <ul slot="notes">
            <li>
              <code>as</code>: h1–h4, for the outline
            </li>
            <li>
              <code>size</code>: display-1 to display-4, heading-1
            </li>
            <li>
              <code>tone</code>: default, inverse
            </li>
            <li>
              <code>pixel</code>: on by default; a few letters swap into Pixelify Sans, settle in on first view, then
              flicker now and then
            </li>
          </ul>
          <Heading client:visible as="h4" size="display-4" text="Pixel on" />
          <Heading as="h4" size="display-4" pixel={false} text="Pixel off" />
        </Specimen>

        <Specimen name="Tile" file="ui/Tile/Tile.tsx" usage={`<Tile label="01" />`}>
          <p slot="notes">Chapter marker for the frame gutter. Fills the gutter width, same footprint as PixelDoor.</p>
          <div class="gutter-demo">
            <Tile label="01" inset={false} />
          </div>
          <div class="gutter-demo">
            <Tile label="02" inset={false} />
          </div>
        </Specimen>

        <Specimen
          name="PixelDoor"
          file="ui/PixelDoor/PixelDoor.tsx"
          usage={`<PixelDoor client:visible character="/assets/pixel-cat.jpg" offset />`}
        >
          <ul slot="notes">
            <li>States: closed, peek (hover, or flapping while the page scrolls), open (click)</li>
            <li>Ajar doors leak warm light: in the gap, a faint beam to the side, a sliver below</li>
            <li>
              <code>offset</code>: flap half a beat later than neighbours
            </li>
            <li>
              <code>still</code>: ignore scrolling; <code>initialState</code>: start closed, peek or open
            </li>
          </ul>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor client:visible character="/assets/pixel-cat.jpg" still inset={false} />
            </div>
            <figcaption class="text-label-s">Closed</figcaption>
          </figure>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor client:visible character="/assets/pixel-waffle.jpg" still initialState="peek" inset={false} />
            </div>
            <figcaption class="text-label-s">Peek</figcaption>
          </figure>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor
                client:visible
                character="/assets/pixel-beet.jpg?v=2"
                still
                initialState="open"
                inset={false}
              />
            </div>
            <figcaption class="text-label-s">Open</figcaption>
          </figure>
        </Specimen>

        <Specimen
          name="AsciiVisual"
          file="ui/AsciiVisual/AsciiVisual.tsx"
          usage={`<AsciiVisual src="/assets/bookit-floorplan.jpg" focus="0.6 0.55" caption="BookIT / Floorplan editor" />`}
        >
          <ul slot="notes">
            <li>
              Redraws a screenshot as a coloured glyph mosaic; light UI is inverted so ink and colour carry the shape
            </li>
            <li>Resolves from noise on first view; glyphs scramble under the pointer</li>
            <li>
              <code>focus</code>: which part to keep when cropping
            </li>
          </ul>
          <div class="visual-demo">
            <AsciiVisual
              client:visible
              src="/assets/bookit-floorplan.jpg"
              focus="0.6 0.55"
              caption="BookIT / Floorplan editor"
            />
          </div>
        </Specimen>

        <Specimen
          name="SignalField"
          file="ui/SignalField/SignalField.tsx"
          usage={`<SignalField tone="light" text="TetianaDovgalenko" />`}
        >
          <ul slot="notes">
            <li>
              <code>tone</code>: dark (light glyphs, hero) or light (dark glyphs, contact band)
            </li>
            <li>
              <code>text</code>: run a word on a loop instead of random glyphs
            </li>
            <li>
              <code>fade</code>, <code>top</code>, <code>opacity</code> for placement
            </li>
          </ul>
          <div class="field-demo" data-signal-host>
            <SignalField client:visible />
          </div>
          <div class="field-demo field-demo--light" data-signal-host>
            <SignalField client:visible tone="light" text="TetianaDovgalenko" opacity={0.65} />
          </div>
        </Specimen>

        <Specimen
          name="SkillGrid"
          file="ui/SkillGrid/SkillGrid.tsx"
          usage={`<SkillGrid items={["Domain modelling", "Information architecture", …]} />`}
        >
          <p slot="notes">Three columns, two at medium width, a list on narrow screens. Cells invert on hover.</p>
          <div class="grid-demo">
            <SkillGrid items={["Domain modelling", "Information architecture", "Role-based workflows"]} />
          </div>
        </Specimen>

        <FrameRow>
          <div class="patterns">
            <p class="text-label-m token-group">Layout & patterns</p>
            <dl>
              <div>
                <dt>Frame + FrameRow</dt>
                <dd>
                  The bordered container with gutter columns. Rows take a <code>gutter</code> slot and a{" "}
                  <code>divider</code> (top, none, both).
                </dd>
              </div>
              <div>
                <dt>RuledSection</dt>
                <dd>Editorial section with an index line, used by Working method and About.</dd>
              </div>
              <div>
                <dt>CapabilityChapter</dt>
                <dd>Tile + chapter title + intro; groups capability blocks.</dd>
              </div>
              <div>
                <dt>CapabilityBlock</dt>
                <dd>
                  Door + title + statement, copy with proof Button, AsciiVisual, SkillGrid. Content comes from{" "}
                  <code>src/data/capabilities.js</code>; <code>flip</code> alternates.
                </dd>
              </div>
              <div>
                <dt>ContactBand</dt>
                <dd>Inverse band with a light SignalField, heading-1 and a dark Button.</dd>
              </div>
            </dl>
          </div>
        </FrameRow>
      </DocSection>
      <div class="end-space"></div>
    </Frame>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .system {
    padding-top: calc(var(--layout-header-height) + 2 * var(--space-page));
  }

  .intro {
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .intro > .text-label-l,
  .token-group {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .intro-lead {
    max-width: 40rem;
    margin: var(--space-xl) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--font-line-height-relaxed);
  }

  .intro-actions {
    margin-top: var(--space-2xl);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .toc a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-text-primary);
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .pipeline li {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-xl) var(--space-inset-inline);
  }

  .pipeline li:not(:last-child) {
    border-right: 1px solid var(--color-border-default);
  }

  .pipeline span,
  .pipeline small {
    color: var(--color-text-muted);
  }

  .pipeline strong {
    font-size: var(--font-size-body-m);
    font-weight: var(--font-weight-regular);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
  }

  .swatch {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-l);
    border-right: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .swatch-chip {
    display: block;
    height: 4rem;
    margin-bottom: var(--space-2xs);
    border: 1px solid var(--color-border-subtle);
  }

  .swatch .text-label-s,
  .token-note {
    color: var(--color-text-muted);
  }

  code {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
  }

  .token-table {
    padding: var(--space-xl) var(--space-inset-inline);
  }

  .token-table--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  .token-line {
    display: grid;
    grid-template-columns: 2.5rem minmax(14rem, 1fr) minmax(10rem, 1fr) minmax(0, 1.4fr);
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-2xs) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .token-line--plain {
    grid-template-columns: minmax(14rem, 1fr) minmax(8rem, 1fr) minmax(0, 1.4fr);
  }

  .token-line--space {
    grid-template-columns: 9rem minmax(14rem, 1fr) minmax(10rem, 1fr) minmax(0, 1.4fr);
  }

  .token-preview {
    display: block;
    width: 2.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-border-subtle);
  }

  .token-ref {
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
  }

  .space-bar {
    display: block;
    max-width: 9rem;
    height: 0.6rem;
    background: var(--color-accent-default);
  }

  .type-row {
    display: grid;
    grid-template-columns: minmax(14rem, 0.5fr) minmax(0, 1.5fr);
    gap: var(--space-xl);
    align-items: baseline;
    padding: var(--space-l) var(--space-inset-inline);
  }

  .type-meta {
    display: grid;
    gap: var(--space-3xs);
  }

  .type-sample {
    margin: 0;
    overflow: hidden;
    letter-spacing: var(--font-tracking-heading);
    line-height: var(--font-line-height-heading);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .type-sample.text-label-l {
    letter-spacing: var(--font-tracking-label);
  }

  .gutter-demo {
    width: 6.5rem;
  }

  .door-demo {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    color: var(--color-text-muted);
  }

  .visual-demo {
    width: 100%;
    height: 18rem;
    border: 1px solid var(--color-border-default);
  }

  .field-demo {
    position: relative;
    flex: 1 1 14rem;
    height: 12rem;
    overflow: hidden;
    border: 1px solid var(--color-border-default);
    isolation: isolate;
  }

  .field-demo--light {
    background: var(--color-surface-inverse);
  }

  .grid-demo {
    width: 100%;
    border: 1px solid var(--color-border-default);
  }

  .patterns {
    padding: var(--space-xl) var(--space-inset-inline);
  }

  .patterns dl {
    margin: 0;
  }

  .patterns dl > div {
    display: grid;
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    gap: var(--space-xl);
    padding: var(--space-s) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  dt {
    font-size: var(--font-size-body-m);
  }

  dd {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--font-line-height-relaxed);
  }

  .end-space {
    height: var(--space-section);
  }

  @media (max-width: 980px) {
    .pipeline {
      grid-template-columns: 1fr 1fr;
    }

    .pipeline li:nth-child(2) {
      border-right: 0;
    }

    .pipeline li:nth-child(n + 3) {
      border-top: 1px solid var(--color-border-default);
    }

    .token-line,
    .token-line--plain,
    .token-line--space {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .token-table--split,
    .type-row,
    .patterns dl > div {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .intro,
    .token-table,
    .type-row,
    .patterns,
    .pipeline li {
      padding-right: var(--space-m);
      padding-left: var(--space-m);
    }

    .pipeline {
      grid-template-columns: 1fr;
    }

    .pipeline li,
    .pipeline li:nth-child(2) {
      border-right: 0;
    }

    .pipeline li:not(:first-child) {
      border-top: 1px solid var(--color-border-default);
    }
  }
</style>
