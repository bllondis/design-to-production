---
import BaseLayout from "../layouts/BaseLayout.astro";
import Frame from "../components/layout/Frame.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import CapabilityBlock from "../components/sections/CapabilityBlock.astro";
import CapabilityChapter from "../components/sections/CapabilityChapter.astro";
import ContactBand from "../components/sections/ContactBand.astro";
import Hero from "../components/sections/Hero.astro";
import MethodSection from "../components/sections/MethodSection.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import { chapters } from "../data/capabilities.js";
---

<BaseLayout
  title="Tetiana Dovgalenko | Product Designer and Design Engineer"
  description="Tetiana Dovgalenko is a Product Designer and Design Engineer working across complex B2B software, AI-assisted products, and design systems."
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <Frame id="work" aria-label="Capabilities">
      {
        chapters.map((chapter, chapterIndex) => (
          <CapabilityChapter
            id={chapter.id}
            number={chapter.number}
            title={chapter.title}
            intro={chapter.intro}
            first={chapterIndex === 0}
          >
            {chapter.blocks.map((block, blockIndex) => (
              <CapabilityBlock {...block} flip={blockIndex % 2 === 1} />
            ))}
          </CapabilityChapter>
        ))
      }
    </Frame>
    <MethodSection />
    <AboutSection />
    <ContactBand />
  </main>
  <SiteFooter />
</BaseLayout>
