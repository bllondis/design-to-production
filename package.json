{
  "name": "tetiana-dovgalenko-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/ui",
    "apps/portfolio"
  ],
  "scripts": {
    "tokens": "npm run build -w @tetiana/tokens",
    "cv": "npm run cv -w portfolio",
    "dev": "npm run dev -w portfolio",
    "storybook": "npm run storybook -w @tetiana/ui",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run tokens && npm run build -w portfolio && npm run build-storybook -w @tetiana/ui && node apps/portfolio/scripts/build-site.mjs",
    "test": "npm test -w @tetiana/ui && node --test apps/portfolio/scripts/*.test.mjs",
    "test:e2e": "npm run build && npm run test:e2e -w portfolio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
