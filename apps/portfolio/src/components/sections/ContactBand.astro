---
import Frame from "../layout/Frame.astro";
import FrameRow from "../layout/FrameRow.astro";
import { Button, Heading, SignalField } from "@tetiana/ui";
import { person } from "../../data/site.js";
---

<Frame id="contact" aria-labelledby="contact-title">
  <div class="closing">
    <FrameRow divider="both">
      <div class="band" data-signal-host>
        <SignalField client:visible tone="light" text={person.name.replace(" ", "")} opacity={0.65} />
        <Heading
          client:visible
          id="contact-title"
          size="heading-1"
          tone="inverse"
          measure={14}
          text="Have a complex system that needs to feel simple?"
        />
        <div class="band-side">
          <p>
            I work between product logic, interaction design, and implementation for complex B2B software, AI-assisted
            products, and design systems.
          </p>
          <div class="band-action">
            <Button href={`mailto:${person.email}`} variant="dark" size="s">
              Get in touch
            </Button>
          </div>
        </div>
      </div>
    </FrameRow>
  </div>
</Frame>

<style>
  .closing {
    padding: clamp(4rem, 8vw, 7.5rem) 0;
  }

  .band {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    min-height: clamp(26rem, 34vw, 32rem);
    align-content: end;
    align-items: start;
    overflow: hidden;
    padding: clamp(2.5rem, 4vw, 3.75rem);
    isolation: isolate;
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .band-side {
    max-width: var(--layout-measure);
    padding-top: 0.45em;
  }

  .band-side p {
    margin: 0;
    color: var(--color-text-inverse-body);
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.65;
  }

  .band-action {
    margin-top: 2.25rem;
  }

  @media (max-width: 980px) {
    .band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .band {
      padding: var(--space-xl) var(--space-m);
    }
  }
</style>
