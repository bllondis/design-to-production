---
/**
 * MethodSection: the working method on the frame grid. Steps sit in the same two columns as the chapter head,
 * and alternate highlight bands, not rules, tell them apart. The step on the centre line of the viewport lifts a
 * little while scrolling.
 */
import FrameRow from "../layout/FrameRow.astro";
import Section from "../case/Section.astro";

interface Props {
  label?: string;
  title?: string;
  intro?: string;
  steps?: string[][];
}

const {
  label = "Working method / System to interface",
  title = "Model the system before\npolishing the interface",
  intro = "From understanding the domain to validating how the system behaves in the product",
  steps = [
    ["Understand", "Domain, rules, constraints"],
    ["Model", "States, relationships, edge cases"],
    ["Reduce", "Hierarchy, guidance, disclosure"],
    ["Prototype", "Flows, behaviour, critical states"],
    ["Build", "Components, feasibility, implementation"],
    ["Validate", "Behaviour, edge cases, iteration"],
  ],
} = Astro.props;
---

<section class="method" aria-labelledby="method-title">
  <Section label={label} title={title} size="heading-1" pixel={false} measure={17} headingId="method-title">
    <p>{intro}</p>
  </Section>
  <FrameRow divider="both">
    <ol class="steps">
      {steps.map(([step, detail], index) => (
        <li>
          <p class="step-name">
            <span class="text-label-m">{String(index + 1).padStart(2, "0")}</span>
            {step}
          </p>
          <p class="step-detail">{detail}</p>
        </li>
      ))}
    </ol>
  </FrameRow>
</section>

<style>
  /* The title keeps its two set lines. Where the column is too narrow for the longer one (about 10.2em), the size
     follows the column width instead. */
  .method :global(.section-head > div:first-child) {
    container-type: inline-size;
  }

  .method :global(h2) {
    font-size: min(var(--font-size-heading-1), 9.8cqi);
    white-space: nowrap;
  }

  /* Keep the authored two-line titles intact while fitting scripts and translations with different glyph widths. */
  :global(html[lang="uk"]) .method :global(h2) {
    font-size: min(var(--font-size-heading-1), 6.8cqi);
  }

  :global(html[lang="nl"]) .method :global(h2) {
    font-size: min(var(--font-size-heading-1), 8cqi);
  }

  .steps {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* The same two columns and gap as the Section head, so names and details line up with the title and lead. */
  .steps li {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: baseline;
    padding: var(--space-l) var(--space-inset-inline);
    transition: background-color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  .steps li:nth-child(even) {
    background-image: linear-gradient(90deg, var(--color-surface-glow), transparent 85%);
  }

  .step-name {
    display: flex;
    gap: var(--space-l);
    align-items: baseline;
    margin: 0;
    font-size: var(--font-size-heading-2);
    letter-spacing: var(--font-tracking-heading);
    line-height: var(--font-line-height-compact);
  }

  .step-name span {
    min-width: 2ch;
    color: var(--color-accent-default);
  }

  .step-detail {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    transition: color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  @media (hover: hover) {
    .steps li:hover {
      background-color: var(--color-surface-glow);
    }

    .steps li:hover .step-detail {
      color: var(--color-text-primary);
    }
  }

  @media (max-width: 980px) {
    .steps li {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }

  @media (max-width: 680px) {
    .steps li {
      padding: var(--space-m);
    }

    .step-detail {
      font-size: var(--font-size-body-m);
    }
  }
</style>
