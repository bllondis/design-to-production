---
/**
 * SiteHeader: name and primary navigation in a bordered bar above the page.
 *
 * flush  sit on the top edge instead of var(--space-page) below it (the home hero)
 */
import { person, primaryNav } from "../../data/site.js";
import { MobileNav } from "@tetiana/ui";

interface HeaderLink {
  label: string;
  href: string;
  external?: boolean;
  ariaLabel?: string;
  mobileLabel?: string;
}

interface LanguageOption {
  code: string;
  shortLabel: string;
  label: string;
  flag: string;
  href: string;
  active?: boolean;
}

interface Props {
  flush?: boolean;
  homeHref?: string;
  identityLabel?: string;
  navLabel?: string;
  navItems?: HeaderLink[];
  homeAction?: HeaderLink;
  languages?: LanguageOption[];
  languageTrigger?: string;
  languageMenu?: string;
  menuOpen?: string;
  menuClose?: string;
  readingProgress?: boolean;
}

const {
  flush = false,
  homeHref = "/#top",
  identityLabel = `${person.name}, home`,
  navLabel = "Primary navigation",
  navItems = primaryNav,
  homeAction,
  languages = [],
  languageTrigger = "Change language. Current language: {label}",
  languageMenu = "Languages",
  menuOpen = "Open menu",
  menuClose = "Close menu",
  readingProgress = false,
} = Astro.props;
const activeLanguage = languages.find((language) => language.active) ?? languages[0];
---

<header class:list={["header", { "header--flush": flush }]} data-reading-progress={readingProgress ? "" : undefined}>
  <a class="identity" href={homeHref} aria-label={identityLabel}>
    {person.name}
  </a>
  <div class="header-actions">
    {homeAction && (
      <a class="home-action text-label-l" href={homeAction.href} aria-label={homeAction.ariaLabel ?? homeAction.label}>
        <span class="home-action-label" aria-hidden={homeAction.ariaLabel ? "true" : undefined}>
          {homeAction.label}
        </span>
        {homeAction.mobileLabel && (
          <span class="home-action-mobile" aria-hidden="true">
            {homeAction.mobileLabel}
          </span>
        )}
      </a>
    )}
    {activeLanguage && (
      <details class="language-switcher" data-language-switcher data-current-language={activeLanguage.code}>
        <summary
          class="language-trigger text-label-l"
          aria-label={languageTrigger.replace("{label}", activeLanguage.label)}
        >
          <span>{activeLanguage.shortLabel}</span>
          <span class="language-flag" aria-hidden="true">
            {activeLanguage.flag}
          </span>
        </summary>
        <ul class="language-menu" aria-label={languageMenu}>
          {languages.map((language) => (
            <li>
              <a
                class="language-option text-label-m"
                href={language.href}
                lang={language.code}
                aria-current={language.active ? "page" : undefined}
              >
                <span>{language.shortLabel}</span>
                <span class="language-name">{language.label}</span>
                <span class="language-mark" aria-hidden="true">
                  ●
                </span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <nav class="nav" aria-label={navLabel}>
      {navItems.map((item) => (
        <a
          class="text-label-l"
          href={item.href}
          {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <MobileNav
      client:load
      links={navItems}
      languages={languages}
      languageLabel={languageMenu}
      label={navLabel}
      openLabel={menuOpen}
      closeLabel={menuClose}
    />
  </div>
  {readingProgress && (
    <span class="reading-progress" aria-hidden="true">
      <span></span>
    </span>
  )}
</header>

<script>
  const switchers = document.querySelectorAll<HTMLDetailsElement>("[data-language-switcher]");

  switchers.forEach((switcher) => {
    const trigger = switcher.querySelector<HTMLElement>("summary");

    switcher.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      switcher.removeAttribute("open");
      trigger?.focus();
    });
  });

  document.addEventListener("click", (event) => {
    switchers.forEach((switcher) => {
      if (!switcher.contains(event.target as Node)) switcher.removeAttribute("open");
    });
  });

  const siteHeader = document.querySelector<HTMLElement>("body > header");
  const narrowScreen = window.matchMedia("(max-width: 680px)");
  let previousScroll = window.scrollY;
  let scrollFrame = 0;

  const updateMobileHeader = () => {
    scrollFrame = 0;
    if (!siteHeader || !narrowScreen.matches) return;
    const currentScroll = window.scrollY;
    const delta = currentScroll - previousScroll;
    const menuOpen = document.body.hasAttribute("data-mobile-nav-open");
    const nearTop = currentScroll < 24;

    if (nearTop || menuOpen || delta < -8) siteHeader.classList.remove("header--hidden");
    else if (delta > 8 && currentScroll > siteHeader.offsetHeight) siteHeader.classList.add("header--hidden");

    if (siteHeader.hasAttribute("data-reading-progress")) {
      const range = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      siteHeader.style.setProperty("--reading-progress", `${Math.min(currentScroll / range, 1)}`);
    }
    previousScroll = currentScroll;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateMobileHeader);
    },
    { passive: true },
  );
  updateMobileHeader();
</script>

<style>
  .header {
    --site-header-top: var(--space-page);

    position: absolute;
    top: var(--space-page);
    left: var(--space-page);
    z-index: 2;
    display: flex;
    width: calc(100% - (2 * var(--space-page)));
    min-height: var(--layout-header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: 0 1.55rem;
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-header);
    color: var(--color-text-primary);
  }

  .header--flush {
    --site-header-top: 0px;

    top: 0;
  }

  .identity {
    min-width: 0;
    font-size: clamp(1.1rem, 2vw, 1.65rem);
    letter-spacing: var(--font-tracking-tight);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .reading-progress {
    display: none;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 2rem);
  }

  .nav a {
    position: relative;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--motion-duration-fade) var(--motion-easing-standard);
  }

  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switcher {
    position: relative;
    flex: none;
  }

  .home-action,
  .language-trigger {
    display: flex;
    min-height: var(--space-xl);
    align-items: center;
    gap: var(--space-2xs);
    padding: 0 var(--space-xs);
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-header);
    color: var(--color-text-secondary);
    cursor: pointer;
    list-style: none;
    transition:
      background var(--motion-duration-hover) var(--motion-easing-standard),
      color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  .home-action {
    text-decoration: none;
  }

  .home-action-mobile {
    display: none;
  }

  .language-trigger::-webkit-details-marker {
    display: none;
  }

  .home-action:hover,
  .home-action:focus-visible,
  .language-trigger:hover,
  .language-switcher[open] .language-trigger {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .language-flag {
    font-family: system-ui, sans-serif;
    font-size: var(--font-size-body-s);
    line-height: 1;
  }

  .language-menu {
    position: absolute;
    top: calc(100% + var(--space-2xs));
    right: 0;
    z-index: 3;
    min-width: max-content;
    margin: 0;
    padding: var(--space-3xs);
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-header);
    list-style: none;
  }

  .language-option {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-xs);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition:
      background var(--motion-duration-hover) var(--motion-easing-standard),
      color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  .language-option:hover,
  .language-option[aria-current="page"] {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .language-name {
    color: var(--color-text-secondary);
  }

  .language-option:hover .language-name,
  .language-option[aria-current="page"] .language-name {
    color: currentColor;
  }

  .language-mark {
    color: transparent;
  }

  .language-option[aria-current="page"] .language-mark {
    color: var(--color-accent-default);
  }

  @media (max-width: 680px) {
    .header {
      --site-header-top: env(safe-area-inset-top, 0px);

      position: fixed;
      top: var(--site-header-top);
      z-index: 5;
      gap: var(--space-s);
      padding: 0 0.85rem;
      transition: top var(--motion-duration-fade) var(--motion-easing-standard);
    }

    .header--hidden {
      top: calc(var(--layout-header-height) * -1);
    }

    .identity {
      font-size: var(--font-size-body-s);
    }

    .header-actions {
      gap: var(--space-xs);
    }

    .nav {
      display: none;
    }

    .language-switcher {
      display: none;
    }

    .home-action {
      min-width: var(--mobile-nav-trigger-size);
      min-height: var(--mobile-nav-trigger-size);
      justify-content: center;
      padding: 0 var(--space-2xs);
      font-size: var(--font-size-body-l);
      line-height: 1;
    }

    .home-action-label {
      display: none;
    }

    .home-action-mobile {
      display: inline;
    }

    .reading-progress {
      position: absolute;
      right: -1px;
      bottom: -1px;
      left: -1px;
      display: block;
      height: 2px;
      overflow: hidden;
      background: var(--color-border-subtle);
    }

    .reading-progress span {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--color-accent-default);
      transform: scaleX(var(--reading-progress, 0));
      transform-origin: left;
    }
  }

  @media (max-width: 680px) and (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }
</style>
