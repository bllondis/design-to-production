---
/** AboutSection: who I am on the frame grid, closed by a highlight band with the visual practice. */
import FrameRow from "../layout/FrameRow.astro";
import Section from "../case/Section.astro";

const practice = ["Photography", "Fashion", "Costume", "Visual direction"];
---

<section class="about" id="about" aria-labelledby="about-title">
  <Section
    label="About"
    title={"Hello, I’m Tetiana\nNice to meet you"}
    size="heading-1"
    pixel={false}
    measure={17}
    headingId="about-title"
  >
    <p>
      I like making products that feel clear, considered and visually strong, especially when the system underneath is
      complex and data-heavy.
    </p>
    <p>
      Working with AI pushed me closer to code, prototyping and engineering tools. It changed the way I design, because
      I can now move further from an idea into something that actually works.
    </p>
    <p>Originally from Kyiv, I’ve been based in The Hague since 2018.</p>
    <p>
      Before product design, I worked with fabric, light and composition. I spent six years as a costume artist in film
      production, studied art history and painting, and I still carry a camera almost everywhere.
    </p>
  </Section>
  <FrameRow divider="both">
    <div class="practice">
      <p class="text-label-l">Beyond product / Visual practice</p>
      <ul>
        {practice.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </FrameRow>
</section>

<style>
  /* The lead runs long here, so the greeting starts level with it instead of sinking to its last line. */
  .about :global(.section-head) {
    align-items: start;
  }

  /* Same columns as the Section head, on the highlight band the method steps use. */
  .practice {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: baseline;
    padding: var(--space-xl) var(--space-inset-inline);
    background: linear-gradient(90deg, var(--color-surface-glow), transparent 85%);
  }

  .practice > p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .practice ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    padding: 0;
    margin: 0;
    font-size: var(--font-size-heading-2);
    letter-spacing: var(--font-tracking-heading);
    list-style: none;
  }

  .practice li:not(:last-child)::after {
    margin-left: 1.2rem;
    color: var(--color-accent-default);
    content: "/";
  }

  @media (max-width: 980px) {
    .practice {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }

  @media (max-width: 680px) {
    .practice {
      padding: var(--space-l) var(--space-m);
    }

    .practice ul {
      display: grid;
    }

    .practice li:not(:last-child)::after {
      display: none;
    }
  }
</style>
