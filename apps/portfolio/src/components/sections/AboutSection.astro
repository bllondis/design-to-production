---
import RuledSection from "../layout/RuledSection.astro";
import { Heading } from "@tetiana/ui";

const practice = ["Photography", "Fashion", "Costume", "Visual direction"];
---

<RuledSection label="About" note="The Hague / NL" id="about" aria-labelledby="about-title">
  <div class="about-grid">
    <Heading
      id="about-title"
      size="display-3"
      pixel={false}
      measure={10.5}
      text="Product logic, interaction design, and implementation belong in the same conversation."
    />
    <div class="about-copy">
      <p>
        I am a Product Designer and Design Engineer focused on complex enterprise systems. I work between product logic,
        interaction design, and implementation to make dense workflows feel clear and trustworthy.
      </p>
      <p>
        A background in visual practice adds art-direction sensitivity, while hands-on product building keeps decisions
        grounded in how systems actually behave.
      </p>
    </div>
  </div>
  <div class="practice" aria-label="Beyond product, visual practice">
    <p class="text-label-m">Beyond product / Visual practice</p>
    <ul>
      {practice.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</RuledSection>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-top: clamp(3rem, 8vw, 7.5rem);
  }

  .about-copy {
    padding-top: var(--space-3xl);
  }

  .about-copy p {
    max-width: 38rem;
    margin: 1.2rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-m);
    line-height: 1.55;
  }

  .about-copy p:first-child {
    color: var(--color-text-primary);
  }

  .practice {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-xl);
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border-default);
  }

  .practice > p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.6rem;
  }

  .practice ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    padding: 0;
    margin: 0;
    font-size: var(--font-size-heading-2);
    letter-spacing: -0.03em;
    list-style: none;
  }

  .practice li:not(:last-child)::after {
    margin-left: 1.2rem;
    color: var(--color-accent-default);
    content: "/";
  }

  @media (max-width: 980px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-copy {
      max-width: 42rem;
      padding-top: 0;
    }
  }

  @media (max-width: 680px) {
    .practice {
      grid-template-columns: 1fr;
    }

    .practice ul {
      display: grid;
    }

    .practice li:not(:last-child)::after {
      display: none;
    }
  }
</style>
