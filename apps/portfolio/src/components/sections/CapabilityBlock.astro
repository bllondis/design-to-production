---
/**
 * CapabilityBlock: one capability — title and statement, a short case for it with a link to
 * the proof project, the project rendered as an AsciiVisual, and the skills it involves.
 *
 * flip    put the visual on the left; the home page alternates this so blocks zig-zag
 * motion  what the character does when its door opens; without one it waits behind a PixelDoor
 *         walk    PixelWalk: a second door across the title row, and the character walks between them
 *         bow     PixelWalk on its bow route: a somersault out, a bow in the middle of the row, and back
 *         fly     PixelFlight: a bird that leaves its door and flies about the page
 *         burrow  PixelBurrow: it jumps down and plants itself in the row's bottom line
 *         hang    PixelHang: it climbs out, very slowly, and falls asleep hanging from the door
 */
import FrameRow from "../layout/FrameRow.astro";
import {
  AsciiVisual,
  Button,
  Heading,
  PixelBurrow,
  PixelDoor,
  PixelFlight,
  PixelHang,
  PixelStage,
  PixelWalk,
  SkillGrid,
} from "@tetiana/ui";

type Motion =
  | { kind: "walk"; sprite: string }
  | { kind: "bow"; sprite: string; flourish?: string }
  | { kind: "fly"; walk: string; flight: string }
  | { kind: "burrow"; sprite: string }
  | { kind: "hang"; sprite: string };

interface Props {
  id: string;
  title: string;
  statement: string;
  body: string;
  proof: string;
  action: { label: string; href: string };
  secondary?: { label: string; href: string };
  visual: { src: string; focus?: string; caption?: string };
  character: string;
  motion?: Motion;
  skills: string[];
  flip?: boolean;
  skillsLabel?: string;
  openDoorLabel?: string;
  closeDoorLabel?: string;
  doorHint?: string;
}

const {
  id,
  title,
  statement,
  body,
  proof,
  action,
  secondary,
  visual,
  character,
  motion,
  skills,
  flip = false,
  skillsLabel = "What I bring",
  openDoorLabel = "Open the pixel door",
  closeDoorLabel = "Close the pixel door",
  doorHint,
} = Astro.props;
const titleId = `${id}-title`;
---

<article class:list={["capability", { "capability--flip": flip }]} aria-labelledby={titleId}>
  <FrameRow as="header">
    {motion?.kind === "walk" || motion?.kind === "bow" ? (
      <PixelWalk
        slot="across"
        client:visible
        character={character}
        sprite={motion.sprite}
        route={motion.kind === "bow" ? "bow" : "across"}
        leap={motion.kind === "bow" ? "flip" : "jump"}
        flourish={motion.kind === "bow" ? motion.flourish : undefined}
        offset={flip}
        openLabel={openDoorLabel}
        closeLabel={closeDoorLabel}
        hint={doorHint}
      />
    ) : (
      <div slot="gutter">
        {motion?.kind === "fly" ? (
          <PixelFlight
            client:visible
            character={character}
            walk={motion.walk}
            flight={motion.flight}
            offset={flip}
            openLabel={openDoorLabel}
            closeLabel={closeDoorLabel}
          />
        ) : motion?.kind === "burrow" ? (
          <PixelBurrow
            client:visible
            character={character}
            sprite={motion.sprite}
            offset={flip}
            openLabel={openDoorLabel}
            closeLabel={closeDoorLabel}
          />
        ) : motion?.kind === "hang" ? (
          <PixelHang
            client:visible
            character={character}
            sprite={motion.sprite}
            offset={flip}
            openLabel={openDoorLabel}
            closeLabel={closeDoorLabel}
          />
        ) : (
          <PixelDoor
            client:visible
            character={character}
            offset={flip}
            openLabel={openDoorLabel}
            closeLabel={closeDoorLabel}
          />
        )}
      </div>
    )}
    <div class="capability-head">
      <Heading client:visible as="h3" id={titleId} size="display-4" measure={16} text={title} />
      <p class="capability-statement">{statement}</p>
    </div>
    {motion && (
      <PixelStage
        slot="mobile"
        client:visible
        character={character}
        motion={motion}
        openLabel={openDoorLabel}
        closeLabel={closeDoorLabel}
        hint={doorHint}
      />
    )}
  </FrameRow>
  <FrameRow>
    <div class="capability-body">
      <div class="capability-copy">
        <p>{body}</p>
        <div>
          <p class="capability-proof text-label-m">{proof}</p>
          <Button href={action.href}>{action.label}</Button>
          {secondary && (
            <div class="capability-secondary">
              <Button href={secondary.href} variant="text" external>
                {secondary.label}
              </Button>
            </div>
          )}
        </div>
      </div>
      <div class="capability-visual">
        <AsciiVisual client:visible src={visual.src} focus={visual.focus} caption={visual.caption} />
      </div>
    </div>
  </FrameRow>
  <FrameRow divider="both">
    <SkillGrid items={skills} label={skillsLabel} />
  </FrameRow>
</article>

<style>
  .capability {
    margin-top: var(--space-section);
  }

  .capability-head {
    display: flex;
    min-height: clamp(14rem, 22vw, 20rem);
    flex-direction: column;
    justify-content: center;
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .capability-statement {
    max-width: 34ch;
    margin: clamp(1.25rem, 2.2vw, 2rem) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-subtitle);
    letter-spacing: var(--font-tracking-subtitle);
    line-height: var(--font-line-height-base);
  }

  .capability-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: clamp(30rem, 42vw, 40rem);
  }

  .capability-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2xl);
    padding: var(--space-inset);
    background: radial-gradient(130% 90% at 0% 0%, var(--color-surface-glow), transparent 62%);
  }

  .capability-copy > p {
    max-width: 30rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--font-line-height-loose);
  }

  .capability-proof {
    margin: 0 0 1.1rem;
    color: var(--color-text-muted);
  }

  .capability-secondary {
    margin-top: 1.1rem;
  }

  .capability-visual {
    position: relative;
    min-width: 0;
    border-left: 1px solid var(--color-border-default);
  }

  .capability--flip .capability-visual {
    order: -1;
    border-right: 1px solid var(--color-border-default);
    border-left: 0;
  }

  @media (max-width: 680px) {
    .capability-head,
    .capability-copy {
      padding: var(--space-2xl) var(--space-m);
    }

    .capability-head {
      min-height: 0;
    }

    .capability-body {
      grid-template-columns: 1fr;
    }

    .capability-visual,
    .capability--flip .capability-visual {
      order: 0;
      aspect-ratio: 4 / 3;
      border-top: 1px solid var(--color-border-default);
      border-right: 0;
      border-left: 0;
    }
  }
</style>
