---
import { Heading, SignalField } from "@tetiana/ui";
---

<section class="hero" id="top" aria-labelledby="hero-title" data-signal-host>
  <SignalField client:load top="var(--layout-header-height)" fade opacity={0.98} />
  <div class="hero-grid" aria-hidden="true"></div>
  <button class="hero-toggle text-label-s" type="button" data-field-toggle aria-pressed="false">
    <span data-field-toggle-label>Pause signal</span>
    <span aria-hidden="true">[ II ]</span>
  </button>
  <div class="hero-card">
    <p class="hero-kicker text-label-m">Product Designer / Design Engineer</p>
    <Heading
      as="h1"
      id="hero-title"
      size="display-4"
      tone="inverse"
      pixel={false}
      text={"Complex B2B products\nAI‑assisted workflows\nDesign systems"}
    />
  </div>
  <div class="hero-footer" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    grid-template-rows: 1fr auto;
    margin: 0 var(--space-page);
    overflow: hidden;
    padding: clamp(8.5rem, 17vh, 11rem) 0 0;
    isolation: isolate;
  }

  /* The hero's own gutter lines, matching the Frame below it. */
  .hero::before,
  .hero::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: -1;
    width: 1px;
    background: var(--color-border-default);
    content: "";
  }

  .hero::before {
    left: var(--layout-gutter);
  }

  .hero::after {
    right: var(--layout-gutter);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image:
      linear-gradient(var(--color-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px);
    background-size:
      100% 4.6rem,
      var(--layout-gutter) 100%;
    pointer-events: none;
  }

  /* Lets anyone stop the moving field (WCAG 2.2.2). It keeps the page gap under the header on the top edge. */
  .hero-toggle {
    position: absolute;
    top: calc(var(--layout-header-height) + var(--space-page));
    right: var(--space-l);
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-border-default);
    border-radius: 0;
    background: var(--color-surface-page);
    color: var(--color-text-secondary);
    cursor: pointer;
    line-height: 1;
    transition:
      background var(--motion-duration-hover) var(--motion-easing-standard),
      color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  .hero-toggle:hover {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .hero-card {
    align-self: end;
    width: min(68%, 55rem);
    margin: 0 0 0 var(--layout-gutter);
    padding: clamp(2rem, 4vw, 4rem);
    container-type: inline-size;
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  /* The headline keeps its three set lines: no wrapping inside them. Where the card is too narrow for the longest
     line (about 9.2em), the size follows the card width instead. */
  .hero-card :global(h1) {
    font-size: min(var(--font-size-display-4), 10.8cqi);
    white-space: nowrap;
  }

  .hero-kicker {
    margin: 0 0 1.2rem;
    color: var(--color-text-inverse-muted);
  }

  /* The bordered strip that closes the hero: the card rests on it, and the frame below starts under it. */
  .hero-footer {
    min-height: calc(var(--space-2xl) + var(--space-2xs));
    border: 1px solid var(--color-border-default);
    border-bottom: 0;
    background: var(--color-surface-page);
  }

  @media (max-width: 980px) {
    .hero-card {
      width: 76%;
    }
  }

  @media (max-width: 680px) {
    .hero-toggle {
      right: var(--space-page);
    }

    .hero {
      min-height: 47rem;
      padding-top: 7.2rem;
    }

    .hero-card {
      width: 91.667%;
      margin-left: 0;
      padding: var(--space-l);
    }
  }
</style>
