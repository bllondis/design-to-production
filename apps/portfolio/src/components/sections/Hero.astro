---
import { Heading, SignalField } from "@tetiana/ui";

interface Props {
  role?: string;
  title?: string;
}

const {
  role = "Product Designer / Design Engineer",
  title = "Complex B2B products\nAI‑assisted workflows\nDesign systems",
} = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-signal-host>
  <SignalField client:load top="var(--layout-header-height)" fade opacity={0.98} />
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-card">
    <p class="hero-kicker text-label-m">{role}</p>
    <Heading as="h1" id="hero-title" size="display-4" tone="inverse" pixel={false} text={title} />
  </div>
  <div class="hero-footer" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    grid-template-rows: 1fr auto;
    margin: 0 var(--space-page);
    overflow: hidden;
    padding: clamp(8.5rem, 17vh, 11rem) 0 0;
    isolation: isolate;
  }

  /* The hero's own gutter lines, matching the Frame below it. */
  .hero::before,
  .hero::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: -1;
    width: 1px;
    background: var(--color-border-default);
    content: "";
  }

  .hero::before {
    left: var(--layout-gutter);
  }

  .hero::after {
    right: var(--layout-gutter);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image:
      linear-gradient(var(--color-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px);
    background-size:
      100% 4.6rem,
      var(--layout-gutter) 100%;
    pointer-events: none;
  }

  /* The card is as wide as the longest title of any locale (the Dutch one) plus its padding, so that title has even
     space on both sides and every locale gets the same card. Should a font render wider, the card grows with its
     line rather than letting it spill; it never reaches past the right-hand gutter. */
  .hero-card {
    --hero-card-padding: clamp(2rem, 4vw, 4rem);

    align-self: end;
    width: max-content;
    min-width: calc(var(--hero-title-measure) * var(--font-size-display-4) + 2 * var(--hero-card-padding));
    max-width: calc(100% - 2 * var(--layout-gutter));
    margin: 0 0 0 var(--layout-gutter);
    padding: var(--hero-card-padding);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  /* The headline keeps its three set lines: no wrapping inside them. */
  .hero-card :global(h1) {
    white-space: nowrap;
  }

  .hero-kicker {
    margin: 0 0 1.2rem;
    color: var(--color-text-inverse-muted);
  }

  /* The bordered strip that closes the hero: the card rests on it, and the frame below starts under it. */
  .hero-footer {
    min-height: calc(var(--space-2xl) + var(--space-2xs));
    border: 1px solid var(--color-border-default);
    border-bottom: 0;
    background: var(--color-surface-page);
  }

  @media (max-width: 680px) {
    .hero {
      min-height: clamp(34rem, 82svh, 40rem);
      padding-top: 7.2rem;
    }

    .hero-card {
      width: 91.667%;
      min-width: 0;
      max-width: none;
      margin-left: 0;
      padding: var(--space-l);
      container-type: inline-size;
    }

    .hero-card :global(h1) {
      /* Every authored statement remains one line in all locales; the type follows the card width. */
      font-size: min(var(--font-size-display-4), var(--hero-mobile-title-cap));
      overflow-wrap: normal;
      white-space: nowrap;
    }
  }
</style>
