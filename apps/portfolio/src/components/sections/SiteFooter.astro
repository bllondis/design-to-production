---
import Frame from "../layout/Frame.astro";
import FrameRow from "../layout/FrameRow.astro";
import { footerColumns, person } from "../../data/site.js";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  columns?: { title: string; links: FooterLink[] }[];
  ariaLabel?: string;
  legal?: string;
}

const {
  columns = footerColumns,
  ariaLabel = "Footer",
  legal = `${person.name}. Product Design / Design Engineering.`,
} = Astro.props;
---

<Frame as="footer" tone="footer" closed>
  <FrameRow divider="none">
    <nav class="columns" aria-label={ariaLabel}>
      {columns.map((column) => (
        <div>
          <p>{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </FrameRow>
  <FrameRow>
    <p class="legal">© 2026 {legal}</p>
  </FrameRow>
</Frame>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .columns > div {
    padding: clamp(2rem, 3.5vw, 3.5rem);
  }

  .columns > div:not(:last-child) {
    border-right: 1px solid var(--color-border-subtle);
  }

  .columns p {
    margin: 0 0 var(--space-s);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    color: var(--color-text-muted);
    font-size: var(--font-size-body-s);
    line-height: 1.55;
    text-decoration: none;
    transition: color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  a:hover {
    color: var(--color-text-primary);
  }

  .legal {
    margin: 0;
    padding: clamp(2rem, 3.5vw, 3.5rem);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .columns > div:nth-child(2) {
      border-right: 0;
    }

    .columns > div:nth-child(n + 3) {
      border-top: 1px solid var(--color-border-subtle);
    }
  }

  @media (max-width: 680px) {
    .columns > div,
    .legal {
      padding: var(--space-xl) var(--space-m);
    }

    a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }
</style>
