---
import Frame from "../layout/Frame.astro";
import FrameRow from "../layout/FrameRow.astro";
import { footerColumns, person } from "../../data/site.js";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  columns?: { title: string; links: FooterLink[] }[];
  ariaLabel?: string;
  legal?: string;
}

const {
  columns = footerColumns,
  ariaLabel = "Footer",
  legal = `${person.name}. Product Design / Design Engineering.`,
} = Astro.props;
const contactColumn = columns[0];
const topLink = columns.at(-1)?.links.at(-1);
const mobileDockLinks = [
  ...(contactColumn?.links.slice(0, 4).map((link, index) => ({
    ...link,
    icon: ["email", "linkedin", "github", "document"][index],
  })) ?? []),
  ...(topLink ? [{ ...topLink, icon: "top" }] : []),
];
---

<Frame as="footer" tone="footer" closed>
  <FrameRow divider="none">
    <nav class="footer-navigation" aria-label={ariaLabel}>
      <div class="columns">
        {columns.map((column) => (
          <div>
            <p>{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mobile-footer" data-mobile-dock data-visible="false" aria-hidden="true" inert>
        <svg class="mobile-icon-definitions" aria-hidden="true">
          <defs>
            <linearGradient id="footer-gradient-email" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--footer-dock-email-start)"></stop>
              <stop offset="1" stop-color="var(--footer-dock-email-end)"></stop>
            </linearGradient>
            <linearGradient id="footer-gradient-linkedin" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--footer-dock-linkedin-start)"></stop>
              <stop offset="1" stop-color="var(--footer-dock-linkedin-end)"></stop>
            </linearGradient>
            <linearGradient id="footer-gradient-github" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--footer-dock-github-start)"></stop>
              <stop offset="1" stop-color="var(--footer-dock-github-end)"></stop>
            </linearGradient>
            <linearGradient id="footer-gradient-document" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--footer-dock-document-start)"></stop>
              <stop offset="1" stop-color="var(--footer-dock-document-end)"></stop>
            </linearGradient>
            <linearGradient id="footer-gradient-top" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--footer-dock-top-start)"></stop>
              <stop offset="1" stop-color="var(--footer-dock-top-end)"></stop>
            </linearGradient>
            <symbol id="footer-icon-email" viewBox="0 0 24 24">
              <rect x="2.5" y="4.5" width="19" height="15" rx="3" fill="url(#footer-gradient-email)"></rect>
              <path d="m5 8 7 5.25L19 8" fill="none" stroke="var(--footer-dock-glyph)"></path>
              <path d="M5.5 6.75h13" fill="none" stroke="var(--footer-dock-shine)"></path>
            </symbol>
            <symbol id="footer-icon-linkedin" viewBox="0 0 24 24">
              <circle cx="6" cy="6" r="1.5" fill="url(#footer-gradient-linkedin)" stroke="none"></circle>
              <path
                d="M5.25 10v9M10.5 19v-9M10.5 14c0-2.2 1.45-4 3.9-4 2.35 0 3.85 1.8 3.85 4v5M14.4 14v5"
                fill="none"
                stroke="url(#footer-gradient-linkedin)"
              ></path>
            </symbol>
            <symbol id="footer-icon-github" viewBox="0 0 24 24">
              <path
                fill="url(#footer-gradient-github)"
                stroke="none"
                d="M12 3a9 9 0 0 0-2.85 17.54c.45.08.61-.19.61-.43v-1.68c-2.5.54-3.02-1.06-3.02-1.06-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.07 1.38.93 1.38.93.8 1.38 2.11.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.41-1.15.08-2.39 0 0 .76-.24 2.48.92A8.6 8.6 0 0 1 12 7.34a8.6 8.6 0 0 1 2.26.3c1.72-1.16 2.48-.92 2.48-.92.49 1.24.18 2.16.08 2.39.58.63.93 1.44.93 2.42 0 3.46-2.1 4.22-4.11 4.44.32.28.61.83.61 1.68v2.46c0 .24.16.52.62.43A9 9 0 0 0 12 3Z"
              ></path>
            </symbol>
            <symbol id="footer-icon-document" viewBox="0 0 24 24">
              <path d="M5 2.5h9l5 5V21.5H5z" fill="url(#footer-gradient-document)" stroke="none"></path>
              <path d="M14 2.5v5h5M8.5 13h7M8.5 16.5h7" fill="none" stroke="var(--footer-dock-glyph)"></path>
              <path d="M7.25 5h5" fill="none" stroke="var(--footer-dock-shine)"></path>
            </symbol>
            <symbol id="footer-icon-top" viewBox="0 0 24 24">
              <path d="m5.5 11 6.5-6.5 6.5 6.5M12 4.5v15" fill="none" stroke="url(#footer-gradient-top)"></path>
            </symbol>
          </defs>
        </svg>
        <ul class="mobile-dock">
          {mobileDockLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                title={link.label}
                {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <svg class:list={["mobile-dock-icon", `mobile-dock-icon--${link.icon}`]} aria-hidden="true">
                  <use href={`#footer-icon-${link.icon}`}></use>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </FrameRow>
  <FrameRow>
    <p class="legal">© 2026 {legal}</p>
  </FrameRow>
</Frame>

<script>
  const mobileDock = document.querySelector<HTMLElement>("[data-mobile-dock]");

  if (mobileDock) {
    const narrowScreen = window.matchMedia("(max-width: 680px)");
    const hero = document.querySelector<HTMLElement>("#top");
    const contact = document.querySelector<HTMLElement>("#contact");
    const footer = mobileDock.closest<HTMLElement>("footer");
    const popovers = document.querySelectorAll<HTMLElement>("[popover]");
    const observedSections = [contact, footer].filter((section): section is HTMLElement => Boolean(section));
    const visibleSections = new Set<HTMLElement>();
    let previousScroll = window.scrollY;
    let accumulatedScroll = 0;
    let previousDirection = 0;
    let scrollFrame = 0;

    const setDockVisibility = (visible: boolean) => {
      const shouldShow = visible && narrowScreen.matches;
      mobileDock.dataset.visible = String(shouldShow);
      mobileDock.toggleAttribute("inert", !shouldShow);
      mobileDock.setAttribute("aria-hidden", String(!shouldShow));
    };

    const overlayOpen = () =>
      document.body.hasAttribute("data-mobile-nav-open") || document.querySelector(":popover-open") !== null;

    const revealPoint = () => (hero ? hero.offsetTop + hero.offsetHeight * 0.75 : window.innerHeight * 0.75);

    const updateDock = () => {
      scrollFrame = 0;
      const currentScroll = window.scrollY;
      const delta = currentScroll - previousScroll;
      const direction = Math.sign(delta);
      const nearContext = visibleSections.size > 0;
      const beforeContent = currentScroll < revealPoint();

      if (overlayOpen() || beforeContent) {
        setDockVisibility(false);
        accumulatedScroll = 0;
      } else if (nearContext) {
        setDockVisibility(true);
        accumulatedScroll = 0;
      } else if (direction !== 0) {
        accumulatedScroll = direction === previousDirection ? accumulatedScroll + Math.abs(delta) : Math.abs(delta);
        const directionThreshold = mobileDock.offsetHeight * 0.25;

        if (accumulatedScroll >= directionThreshold) {
          setDockVisibility(direction < 0);
          accumulatedScroll = 0;
        }

        previousDirection = direction;
      }

      previousScroll = currentScroll;
    };

    const requestDockUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateDock);
    };

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) visibleSections.add(target);
          else visibleSections.delete(target);
        });
        requestDockUpdate();
      },
      { threshold: 0.08 },
    );

    observedSections.forEach((section) => sectionObserver.observe(section));
    popovers.forEach((popover) => popover.addEventListener("toggle", requestDockUpdate));
    new MutationObserver(requestDockUpdate).observe(document.body, {
      attributes: true,
      attributeFilter: ["data-mobile-nav-open"],
    });
    window.addEventListener("scroll", requestDockUpdate, { passive: true });
    narrowScreen.addEventListener("change", requestDockUpdate);
    updateDock();
  }
</script>

<style>
  .footer-navigation {
    min-width: 0;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .mobile-footer {
    display: none;
  }

  .columns > div {
    padding: clamp(2rem, 3.5vw, 3.5rem);
  }

  .columns > div:not(:last-child) {
    border-right: 1px solid var(--color-border-subtle);
  }

  .columns p {
    margin: 0 0 var(--space-s);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    color: var(--color-text-muted);
    font-size: var(--font-size-body-s);
    line-height: 1.55;
    text-decoration: none;
    transition: color var(--motion-duration-hover) var(--motion-easing-standard);
  }

  a:hover {
    color: var(--color-text-primary);
  }

  .legal {
    margin: 0;
    padding: clamp(2rem, 3.5vw, 3.5rem);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .columns > div:nth-child(2) {
      border-right: 0;
    }

    .columns > div:nth-child(n + 3) {
      border-top: 1px solid var(--color-border-subtle);
    }
  }

  @media (max-width: 680px) {
    .columns {
      display: none;
    }

    .mobile-footer {
      display: block;
      position: fixed;
      z-index: 4;
      bottom: calc(var(--footer-dock-offset) + env(safe-area-inset-bottom, 0px));
      left: 50%;
      padding: 0;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, calc(100% + var(--footer-dock-offset)));
      transition:
        opacity var(--motion-duration-fade) var(--motion-easing-standard),
        transform var(--motion-duration-fade) var(--motion-easing-standard);
    }

    .mobile-footer[data-visible="true"] {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    :global(body[data-mobile-nav-open]) .mobile-footer {
      opacity: 0;
      pointer-events: none;
    }

    .mobile-icon-definitions {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    .mobile-dock {
      display: flex;
      width: max-content;
      gap: var(--footer-dock-gap);
      padding: var(--footer-dock-padding);
      border: var(--footer-dock-border-width) solid var(--footer-dock-border);
      border-radius: var(--footer-dock-surface-radius);
      -webkit-backdrop-filter: blur(var(--footer-dock-glass-blur)) saturate(var(--footer-dock-glass-saturation));
      backdrop-filter: blur(var(--footer-dock-glass-blur)) saturate(var(--footer-dock-glass-saturation));
      background:
        linear-gradient(
          var(--footer-dock-glow-angle),
          var(--color-surface-glow),
          transparent var(--footer-dock-glow-stop)
        ),
        color-mix(in srgb, var(--footer-dock-surface) var(--footer-dock-surface-opacity), transparent);
      box-shadow:
        inset 0 var(--footer-dock-border-width) 0 var(--footer-dock-border),
        0 var(--footer-dock-shadow-y) var(--footer-dock-shadow-blur) var(--footer-dock-shadow);
    }

    .mobile-dock a {
      position: relative;
      display: grid;
      width: var(--footer-dock-size);
      height: var(--footer-dock-size);
      align-items: center;
      justify-content: center;
      color: var(--footer-dock-glyph);
    }

    .mobile-dock-icon {
      width: var(--footer-dock-glyph-size);
      height: var(--footer-dock-glyph-size);
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: var(--footer-dock-icon-stroke-width);
      filter: drop-shadow(
        0 var(--footer-dock-icon-shadow-y) var(--footer-dock-icon-shadow-blur) var(--footer-dock-shadow)
      );
      transition:
        transform var(--motion-duration-hover) var(--motion-easing-standard),
        filter var(--motion-duration-hover) var(--motion-easing-standard);
    }

    .mobile-dock a:hover .mobile-dock-icon,
    .mobile-dock a:focus-visible .mobile-dock-icon {
      filter: brightness(var(--footer-dock-icon-hover-brightness)) saturate(var(--footer-dock-icon-hover-saturation))
        drop-shadow(0 var(--footer-dock-icon-shadow-y) var(--footer-dock-icon-shadow-blur) var(--footer-dock-shadow));
      transform: translateY(calc(-1 * var(--footer-dock-depth))) scale(var(--footer-dock-icon-hover-scale));
    }

    .mobile-dock a:active .mobile-dock-icon {
      transform: translateY(var(--footer-dock-depth)) scale(var(--footer-dock-icon-active-scale));
    }

    .legal {
      padding: var(--space-xl) var(--space-m)
        calc(var(--space-xl) + var(--footer-dock-size) + var(--footer-dock-offset) + env(safe-area-inset-bottom, 0px));
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-footer,
      .mobile-dock-icon {
        transition: none;
      }
    }
  }
</style>
