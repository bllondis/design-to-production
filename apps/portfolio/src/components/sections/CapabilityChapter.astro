---
/**
 * CapabilityChapter: the title row that opens a group of capability blocks.
 * Blocks go in the default slot. Chapters after the first get a gap and a top line.
 */
import FrameRow from "../layout/FrameRow.astro";
import { Heading, Tile } from "@tetiana/ui";

interface Props {
  id: string;
  number: string;
  title: string;
  intro: string;
  first?: boolean;
}

const { id, number, title, intro, first = false } = Astro.props;
const titleId = `${id}-title`;
---

<section class:list={["chapter", { "chapter--first": first }]} aria-labelledby={titleId}>
  <FrameRow as="header" divider={first ? "none" : "top"}>
    <div slot="gutter">
      <Tile label={number} />
    </div>
    <div class="chapter-head">
      <div>
        <p class="chapter-kicker text-label-l">Capability / {number}</p>
        <Heading client:visible id={titleId} size="display-2" measure={9.5} text={title} />
      </div>
      <p class="chapter-intro">{intro}</p>
    </div>
  </FrameRow>
  <slot />
</section>

<style>
  .chapter:not(.chapter--first) {
    margin-top: var(--space-section);
  }

  .chapter-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .chapter-kicker {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .chapter-intro {
    max-width: 30rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-m);
    line-height: var(--font-line-height-relaxed);
  }

  @media (max-width: 980px) {
    .chapter-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .chapter-head {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
