---
/**
 * Section: opens a chapter of a case — mono label and title on the left, the lead text on the right.
 * Visual rows (Shot, Cards, Terms…) follow it in the MDX. The home page uses it for its closing chapters too.
 *
 * size       heading size: "heading-1" (default) or "display-3" for a page-level chapter
 * pixel      pixel letters in the heading; off for long editorial headlines
 * measure    heading measure in ems
 * headingId  id for the heading, so a wrapping landmark can point at it
 * action     a button under the lead, the same as the hero's main action (in MDX: `frontmatter.actions[0]`);
 *            external ones open in a new tab
 */
import FrameRow from "../layout/FrameRow.astro";
import { Button, Heading } from "@tetiana/ui";

interface Props {
  label: string;
  title: string;
  size?: "heading-1" | "display-3";
  pixel?: boolean;
  measure?: number;
  headingId?: string;
  action?: { label: string; href: string; external?: boolean };
}

const { label, title, size = "heading-1", pixel = true, measure = 18, headingId, action } = Astro.props;
const generatedHeadingId = `case-${`${label}-${title}`
  .toLowerCase()
  .normalize("NFKD")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
const resolvedHeadingId = headingId ?? generatedHeadingId;
---

<div class="section" data-case-indexable={headingId ? undefined : ""} data-case-section={headingId ? undefined : label}>
  <FrameRow as="header">
    <div class="section-head">
      <div>
        <p class="section-label text-label-l">{label}</p>
        {pixel ? (
          <Heading client:visible as="h2" id={resolvedHeadingId} size={size} measure={measure} text={title} />
        ) : (
          <Heading as="h2" id={resolvedHeadingId} size={size} pixel={false} measure={measure} text={title} />
        )}
      </div>
      <div class="section-lead">
        <slot />
        {action && (
          <div class="section-action">
            <Button href={action.href} external={action.external}>
              {action.label}
            </Button>
          </div>
        )}
      </div>
    </div>
  </FrameRow>
</div>

<style>
  .section {
    margin-top: var(--space-section);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .section-label {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .section-lead {
    max-width: var(--layout-measure);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--font-line-height-relaxed);
  }

  .section-lead :global(p) {
    margin: 0;
  }

  .section-lead :global(p + p) {
    margin-top: var(--space-s);
  }

  .section-action {
    margin-top: var(--space-xl);
  }

  .section-lead :global(p a) {
    color: var(--color-text-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .section-lead :global(p a:hover) {
    color: var(--color-accent-default);
  }

  @media (max-width: 980px) {
    .section-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .section-head {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
