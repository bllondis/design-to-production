---
/**
 * Section: opens a chapter of a case — mono label and title on the left, the lead text on the right.
 * Visual rows (Shot, Cards, Terms…) follow it in the MDX.
 */
import FrameRow from "../layout/FrameRow.astro";
import { Heading } from "@tetiana/ui";

interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="section">
  <FrameRow as="header">
    <div class="section-head">
      <div>
        <p class="section-label text-label-l">{label}</p>
        <Heading client:visible as="h2" size="heading-1" measure={18} text={title} />
      </div>
      <div class="section-lead">
        <slot />
      </div>
    </div>
  </FrameRow>
</div>

<style>
  .section {
    margin-top: var(--space-section);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .section-label {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .section-lead {
    max-width: var(--layout-measure);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--font-line-height-relaxed);
  }

  .section-lead :global(p) {
    margin: 0;
  }

  .section-lead :global(p + p) {
    margin-top: var(--space-s);
  }

  .section-lead :global(a) {
    color: var(--color-text-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .section-lead :global(a:hover) {
    color: var(--color-accent-default);
  }

  @media (max-width: 980px) {
    .section-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .section-head {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
