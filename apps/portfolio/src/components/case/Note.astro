---
/** Note: a quiet aside about the evidence or limits of what a case shows. */
import FrameRow from "../layout/FrameRow.astro";

interface Props {
  label?: string;
}

const { label = "Note" } = Astro.props;
---

<FrameRow>
  <aside class="note">
    <p class="note-label text-label-m">{label}</p>
    <div class="note-body">
      <slot />
    </div>
  </aside>
</FrameRow>

<style>
  .note {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-l) var(--space-inset-inline);
  }

  .note-label {
    margin: 0;
    color: var(--color-accent-default);
  }

  .note-body {
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: var(--font-line-height-relaxed);
  }

  .note-body :global(p) {
    margin: 0;
  }

  @media (max-width: 680px) {
    .note {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
      padding: var(--space-l) var(--space-m);
    }
  }
</style>
