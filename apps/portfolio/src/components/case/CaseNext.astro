---
/** CaseNext: the closing row of a case, pointing to the next one and back to the overview. */
import FrameRow from "../layout/FrameRow.astro";
import { Button, Heading } from "@tetiana/ui";

interface Props {
  next: { title: string; client: string; href: string };
}

const { next } = Astro.props;
---

<div class="next">
  <FrameRow divider="both">
    <div class="next-row">
      <div>
        <p class="next-label text-label-l">Next case / {next.client}</p>
        <Heading client:visible as="h2" size="heading-1" measure={20} text={next.title} />
      </div>
      <div class="next-actions">
        <Button href={next.href} icon="→">
          Read the case
        </Button>
        <Button href="/#work" variant="text" icon="">
          Back to all capabilities
        </Button>
      </div>
    </div>
  </FrameRow>
</div>

<style>
  /* Padding, not margin, below: a bottom margin would collapse out of the frame and show the page behind. */
  .next {
    margin-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .next-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: var(--space-2xl);
    align-items: end;
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .next-label {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .next-actions {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  @media (max-width: 980px) {
    .next-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .next-row {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
