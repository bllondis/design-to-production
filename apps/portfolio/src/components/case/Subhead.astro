---
/** Subhead: a smaller heading inside a chapter, with an optional one-line note. */
import FrameRow from "../layout/FrameRow.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<FrameRow>
  <div class="subhead">
    <h3>{title}</h3>
    <div class="subhead-note">
      <slot />
    </div>
  </div>
</FrameRow>

<style>
  .subhead {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: baseline;
    padding: var(--space-xl) var(--space-inset-inline);
  }

  h3 {
    margin: 0;
    font-size: var(--font-size-heading-2);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-heading);
    line-height: var(--font-line-height-compact);
  }

  .subhead-note {
    max-width: var(--layout-measure);
    color: var(--color-text-muted);
    line-height: var(--font-line-height-relaxed);
  }

  .subhead-note :global(p) {
    margin: 0;
  }

  @media (max-width: 980px) {
    .subhead {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }

  @media (max-width: 680px) {
    .subhead {
      padding: var(--space-l) var(--space-m);
    }
  }
</style>
