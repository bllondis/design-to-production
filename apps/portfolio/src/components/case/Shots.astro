---
/**
 * Shots: a sequence of screenshots that tell one story, e.g. the same record across states.
 * Two or three across on wide screens, stacked on narrow ones.
 */
import FrameRow from "../layout/FrameRow.astro";
import { Figure } from "@tetiana/ui";

interface Props {
  items: Array<{ src: string; alt: string; caption?: string; width?: number; height?: number }>;
}

const { items } = Astro.props;
---

<FrameRow>
  <div class="shots" style={`--shot-columns: ${Math.min(items.length, 3)}`}>
    {items.map((item, index) => (
      <div class="shot-item">
        <Figure {...item} layout="wide" />
        <span class="shot-counter text-label-m" aria-hidden="true">
          {String(index + 1).padStart(2, "0")} / {String(items.length).padStart(2, "0")}
        </span>
      </div>
    ))}
  </div>
</FrameRow>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(var(--shot-columns), minmax(0, 1fr));
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-inset-inline);
  }

  .shot-item {
    position: relative;
    min-width: 0;
  }

  .shot-counter {
    display: none;
  }

  @media (max-width: 980px) {
    .shots {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .shots {
      display: flex;
      gap: var(--space-s);
      overflow-x: auto;
      padding: var(--space-l) var(--space-m);
      scroll-padding-inline: var(--space-m);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .shots::-webkit-scrollbar {
      display: none;
    }

    .shot-item {
      flex: 0 0 calc(100% - var(--space-xl));
      scroll-snap-align: start;
    }

    .shot-counter {
      position: absolute;
      top: var(--space-xs);
      left: var(--space-xs);
      display: block;
      padding: var(--space-3xs) var(--space-2xs);
      border: 1px solid var(--color-border-subtle);
      background: var(--color-surface-page);
      color: var(--color-text-muted);
    }
  }
</style>
