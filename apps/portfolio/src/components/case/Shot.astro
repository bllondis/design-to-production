---
/** Shot: one full-width screenshot row. */
import FrameRow from "../layout/FrameRow.astro";
import { Figure } from "@tetiana/ui";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const props = Astro.props;
---

<FrameRow>
  <Figure {...props} />
</FrameRow>
