---
/** Cards: InfoCards side by side in equal cells divided by grid lines. */
import FrameRow from "../layout/FrameRow.astro";

interface Props {
  columns?: 1 | 2 | 3 | 4;
}

const { columns = 2 } = Astro.props;
---

<FrameRow divider="both">
  <div class="cards" style={`--card-columns: ${columns}`}>
    <slot />
  </div>
</FrameRow>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(var(--card-columns), minmax(0, 1fr));
  }

  .cards > :global(*:not(:last-child)) {
    border-right: 1px solid var(--color-border-default);
  }

  @media (max-width: 980px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .cards > :global(*:not(:last-child)) {
      border-right: 0;
      border-bottom: 1px solid var(--color-border-default);
    }
  }
</style>
