---
/**
 * Principle: the one sentence a case is built around, set large on a dark panel lit from the top-left corner, the
 * same glow as the capability copy. Light bands are kept for CaseNext and the contact band.
 */
import FrameRow from "../layout/FrameRow.astro";
import { Heading } from "@tetiana/ui";

interface Props {
  label?: string;
  text: string;
}

const { label = "Central design principle", text } = Astro.props;
---

<div class="principle">
  <FrameRow divider="both">
    <figure class="panel">
      <figcaption class="text-label-l">{label}</figcaption>
      <blockquote>
        <Heading client:visible as="h2" size="display-4" measure={16} text={text} />
      </blockquote>
    </figure>
  </FrameRow>
</div>

<style>
  .principle {
    margin-top: var(--space-section);
  }

  .panel {
    display: grid;
    gap: var(--space-xl);
    margin: 0;
    padding: var(--space-inset) var(--space-inset-inline);
    background: radial-gradient(130% 90% at 0% 0%, var(--color-surface-glow), transparent 62%);
  }

  figcaption {
    color: var(--color-text-muted);
  }

  blockquote {
    margin: 0;
  }

  @media (max-width: 680px) {
    .panel {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
