---
/**
 * RuledSection: an editorial section with a thin index line at the top
 * (section name on the left, a note on the right) and generous padding.
 */
interface Props {
  label: string;
  note: string;
  id?: string;
  "aria-labelledby"?: string;
}

const { label, note, ...attributes } = Astro.props;
---

<section class="ruled" {...attributes}>
  <div class="ruled-index text-label-m">
    <span>{label}</span>
    <span>{note}</span>
  </div>
  <slot />
</section>

<style>
  .ruled {
    margin: 0 var(--space-page);
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--color-border-default);
    border-bottom: 0;
  }

  .ruled-index {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-muted);
    font-size: 0.6rem;
  }

  @media (max-width: 680px) {
    .ruled {
      padding-right: var(--space-m);
      padding-left: var(--space-m);
    }
  }
</style>
