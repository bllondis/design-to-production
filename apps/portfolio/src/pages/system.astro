---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocSection from "../components/docs/DocSection.astro";
import Specimen from "../components/docs/Specimen.astro";
import Frame from "../components/layout/Frame.astro";
import FrameRow from "../components/layout/FrameRow.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import {
  AsciiVisual,
  Button,
  ContactPopup,
  Heading,
  PixelBurrow,
  PixelDoor,
  PixelFlight,
  PixelHang,
  PixelStage,
  PixelWalk,
  SignalField,
  SkillGrid,
  Tile,
} from "@tetiana/ui";
import tokens from "@tetiana/tokens/tokens.json";
import { contactLinks } from "../data/site.js";

const byPrefix = (...path) => tokens.filter((token) => path.every((part, index) => token.path[index] === part));
const cssVar = (token) => `--${token.name}`;

const primitiveColors = tokens.filter((token) => token.tier === "primitive" && token.type === "color");
const semanticColorGroups = ["surface", "text", "border", "accent", "light"].map((group) => ({
  group,
  tokens: byPrefix("color", group),
}));
const typeScale = byPrefix("font", "size");
const spacing = byPrefix("space");
const layout = byPrefix("layout");
const durations = byPrefix("motion", "duration");
const easings = byPrefix("motion", "easing");
const tracking = byPrefix("font", "tracking");
const lineHeights = byPrefix("font", "line-height");

// Storybook is built into /storybook for the live site; while developing it runs on its own server.
const storybookUrl = import.meta.env.DEV ? "http://localhost:6006/" : "/storybook/";

const sections = [
  ["tokens", "Tokens"],
  ["color", "Colour"],
  ["type", "Typography"],
  ["space", "Space & layout"],
  ["motion", "Motion"],
  ["components", "Components"],
];
---

<BaseLayout
  title="Design System | Tetiana Dovgalenko"
  description="The tokens, components and patterns this portfolio is built from."
  path="/system/"
>
  <SiteHeader />
  <main id="main" class="system">
    <Frame aria-labelledby="system-title">
      <FrameRow divider="none">
        <div class="intro">
          <p class="text-label-l">Design system / v1</p>
          <Heading
            client:load
            as="h1"
            id="system-title"
            size="display-2"
            measure={11}
            text="The system behind this site."
          />
          <p class="intro-lead">
            Every colour, size and motion on the portfolio comes from one set of tokens, and every block is a component
            with named variants. This page is built from those same components, so it can't drift from the site.
          </p>
          <nav class="toc text-label-m" aria-label="On this page">
            {sections.map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
          <div class="intro-actions">
            <Button href={storybookUrl}>Open Storybook</Button>
          </div>
        </div>
      </FrameRow>

      <DocSection
        id="tokens"
        label="01 / Foundations"
        title="Tokens in three tiers."
        intro="Primitives hold raw values. Semantic tokens say what a value is for. Component tokens hold the decisions of one component, such as a button's hover colour, and point at semantic ones. Changing a primitive updates every role and component that points to it."
      >
        <FrameRow divider="both">
          <ol class="pipeline">
            <li>
              <span class="text-label-s">Source</span>
              <strong>@tetiana/tokens</strong>
              <small>W3C DTCG format</small>
            </li>
            <li>
              <span class="text-label-s">Build</span>
              <strong>Style Dictionary</strong>
              <small>Generates CSS and JSON</small>
            </li>
            <li>
              <span class="text-label-s">Code</span>
              <strong>@tetiana/tokens/tokens.css</strong>
              <small>CSS custom properties</small>
            </li>
            <li>
              <span class="text-label-s">Design</span>
              <strong>Figma Variables</strong>
              <small>Primitives · Semantic · Component</small>
            </li>
          </ol>
        </FrameRow>
      </DocSection>

      <DocSection id="color" label="02 / Colour" title="Ink, paper, one accent and warm light.">
        <FrameRow>
          <div class="swatches">
            {primitiveColors.map((token) => (
              <div class="swatch">
                <span class="swatch-chip" style={`background: var(${cssVar(token)})`} />
                <span class="text-label-s">{token.path.slice(1).join("-")}</span>
                <code>{token.value}</code>
              </div>
            ))}
          </div>
        </FrameRow>
        {semanticColorGroups.map(({ group, tokens: groupTokens }) => (
          <FrameRow>
            <div class="token-table">
              <p class="text-label-m token-group">{group}</p>
              {groupTokens.map((token) => (
                <div class="token-line">
                  <span class="token-preview" style={`background: var(${cssVar(token)})`} />
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.reference ?? token.value}</span>
                  <span class="token-note">{token.description}</span>
                </div>
              ))}
            </div>
          </FrameRow>
        ))}
      </DocSection>

      <DocSection
        id="type"
        label="03 / Typography"
        title="Urbanist for voice, mono for labels, pixels for play."
        intro="Fluid sizes scale with the viewport between a floor and a ceiling. Headings pick a size by role, not by tag."
      >
        {typeScale.map((token) => (
          <FrameRow>
            <div class="type-row">
              <div class="type-meta">
                <code>{cssVar(token)}</code>
                <span class="token-note">{token.description ?? token.value}</span>
              </div>
              <p
                class:list={["type-sample", { "text-label-l": token.path[2].startsWith("label") }]}
                style={`font-size: var(${cssVar(token)})`}
              >
                {token.path[2].startsWith("label")
                  ? "Capability / 01"
                  : token.path[2].startsWith("display")
                    ? "Calm systems"
                    : "Calm interfaces for complex systems"}
              </p>
            </div>
          </FrameRow>
        ))}
        <FrameRow>
          <div class="token-table token-table--split">
            <div>
              <p class="text-label-m token-group">Tracking</p>
              {tracking.map((token) => (
                <div class="token-line token-line--plain">
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.value}</span>
                </div>
              ))}
            </div>
            <div>
              <p class="text-label-m token-group">Line height</p>
              {lineHeights.map((token) => (
                <div class="token-line token-line--plain">
                  <code>{cssVar(token)}</code>
                  <span class="token-ref">{token.value}</span>
                </div>
              ))}
            </div>
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="space"
        label="04 / Space & layout"
        title="A fixed step scale, plus fluid insets for the frame."
        intro="Breakpoints: medium at 980px (gutters collapse, two columns stack) and narrow at 680px (one column, page padding drops to 0.75rem)."
      >
        <FrameRow>
          <div class="token-table">
            {spacing.map((token) => (
              <div class="token-line token-line--space">
                <span class="space-bar" style={`width: var(${cssVar(token)})`} />
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.value}</span>
                <span class="token-note">{token.description}</span>
              </div>
            ))}
            {layout.map((token) => (
              <div class="token-line token-line--plain">
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.value}</span>
                <span class="token-note">{token.description}</span>
              </div>
            ))}
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="motion"
        label="05 / Motion"
        title="Quick to respond, slow to settle."
        intro="All motion stops under prefers-reduced-motion: canvases render a still frame and doors don't flap."
      >
        <FrameRow>
          <div class="token-table">
            {[...durations, ...easings].map((token) => (
              <div class="token-line token-line--plain">
                <code>{cssVar(token)}</code>
                <span class="token-ref">{token.reference ?? token.value}</span>
                <span class="token-note">{token.value}</span>
              </div>
            ))}
          </div>
        </FrameRow>
      </DocSection>

      <DocSection
        id="components"
        label="06 / Components"
        title="Every block, with its variants and states."
        intro="Building blocks are React + TypeScript components in the @tetiana/ui package, each with its CSS module, Storybook story and tests. The portfolio app composes them into pages with Astro: layout (Frame, FrameRow) and sections (CapabilityBlock and friends). Interactive blocks hydrate only when they scroll into view."
      >
        <Specimen
          name="Button"
          file="@tetiana/ui · Button"
          usage={`<Button href="/work/timeflow/">See it in Timeflow</Button>\n<Button popoverTarget="contact-links" variant="dark" size="s">Get in touch</Button>\n<Button href="https://…" variant="text" external>Open live product</Button>`}
        >
          <ul slot="notes">
            <li>
              <code>variant</code>: light (on dark), dark (on light), text
            </li>
            <li>
              <code>size</code>: m, s
            </li>
            <li>
              <code>icon</code>: ↗ (default), ↓, or none
            </li>
            <li>
              <code>popoverTarget</code>: opens a popover instead of following a link
            </li>
            <li>Hover inverts the fill.</li>
          </ul>
          <Button href="#components">Light, m</Button>
          <Button href="#components" variant="text">
            Text link
          </Button>
        </Specimen>
        <Specimen name="Button on light" file="@tetiana/ui · Button" surface="light">
          <p slot="notes">The dark variant is for inverse bands such as the contact section.</p>
          <Button href="#components" variant="dark" size="s">
            Dark, s
          </Button>
          <Button href="#components" variant="dark" icon="↓">
            Download CV
          </Button>
        </Specimen>

        <Specimen
          name="Heading"
          file="@tetiana/ui · Heading"
          usage={`<Heading as="h3" size="display-4" measure={16} text="Design Systems" />`}
        >
          <ul slot="notes">
            <li>
              <code>as</code>: h1–h4, for the outline
            </li>
            <li>
              <code>size</code>: display-1 to display-4, heading-1
            </li>
            <li>
              <code>tone</code>: default, inverse
            </li>
            <li>
              <code>pixel</code>: on by default; a few letters swap into Pixelify Sans, settle in on first view, then
              flicker now and then; Unicode letters are supported across all site languages
            </li>
          </ul>
          <Heading client:visible as="h4" size="display-4" text="Pixel on" />
          <Heading client:visible as="h4" size="display-4" text="Піксельний текст" />
          <Heading as="h4" size="display-4" pixel={false} text="Pixel off" />
        </Specimen>

        <Specimen name="Tile" file="@tetiana/ui · Tile" usage={`<Tile label="01" />`}>
          <p slot="notes">Chapter marker for the frame gutter. Fills the gutter width, same footprint as PixelDoor.</p>
          <div class="gutter-demo">
            <Tile label="01" inset={false} />
          </div>
          <div class="gutter-demo">
            <Tile label="02" inset={false} />
          </div>
        </Specimen>

        <Specimen
          name="PixelDoor"
          file="@tetiana/ui · PixelDoor"
          usage={`<PixelDoor client:visible character="/assets/pixel-cat.jpg" offset />`}
        >
          <ul slot="notes">
            <li>States: closed, peek (hover, or flapping while the page scrolls), open (click)</li>
            <li>Ajar doors leak warm light: in the gap, a faint beam to the side, a sliver below</li>
            <li>
              <code>offset</code>: flap half a beat later than neighbours
            </li>
            <li>
              <code>still</code>: ignore scrolling; <code>initialState</code>: start closed, peek or open
            </li>
            <li>
              <code>hinge</code>: hang the leaf on the right for a right-hand gutter
            </li>
            <li>
              <code>vacant</code>, <code>disabled</code>, <code>open</code>: for a parent that moves the character
            </li>
          </ul>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor client:visible character="/assets/pixel-cat.jpg" still inset={false} />
            </div>
            <figcaption class="text-label-s">Closed</figcaption>
          </figure>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor client:visible character="/assets/pixel-waffle.jpg" still initialState="peek" inset={false} />
            </div>
            <figcaption class="text-label-s">Peek</figcaption>
          </figure>
          <figure class="door-demo">
            <div class="gutter-demo">
              <PixelDoor
                client:visible
                character="/assets/pixel-beet.jpg?v=2"
                still
                initialState="open"
                inset={false}
              />
            </div>
            <figcaption class="text-label-s">Open</figcaption>
          </figure>
        </Specimen>

        <Specimen
          name="PixelWalk"
          file="@tetiana/ui · PixelWalk"
          usage={`<PixelWalk slot="across" client:visible character="/assets/pixel-cat.jpg" sprite="/assets/pixel-cat-walk.png" />`}
        >
          <ul slot="notes">
            <li>A PixelDoor at each end of a row, and the character that lives behind one of them</li>
            <li>
              Click its door: the character jumps out, walks the row's bottom line and hops into the door across; the
              empty door ignores hover and clicks
            </li>
            <li>
              <code>sprite</code>: a four-frame walk strip, built by <code>npm run sprites -w portfolio</code>
            </li>
            <li>
              <code>route="bow"</code>: one door, a walk to the middle of the row, a stage bow, and back
            </li>
            <li>
              <code>flourish</code>: a strip of arm poses for that bow
            </li>
            <li>
              <code>leap="flip"</code>: a somersault in and out of the door instead of a plain jump
            </li>
            <li>
              Goes in a FrameRow's <code>across</code> slot, so the doors land in the gutters; under reduced motion the
              doors only open
            </li>
          </ul>
          <div class="walk-demo">
            <PixelWalk
              client:visible
              character="/assets/pixel-cat.jpg"
              sprite="/assets/pixel-cat-walk.png"
              still
              inset={false}
            />
          </div>
        </Specimen>

        <Specimen
          name="PixelFlight"
          file="@tetiana/ui · PixelFlight"
          usage={`<PixelFlight client:visible character="/assets/pixel-pigeon.jpg" walk="/assets/pixel-pigeon-walk.png" flight="/assets/pixel-pigeon-fly.png" hinge="right" />`}
        >
          <ul slot="notes">
            <li>A PixelDoor with a bird behind it: open the door and it hops down, walks two steps and takes off</li>
            <li>
              It flies about the page and rests on any line marked <code>data-perch</code>, as every FrameRow with a top
              line is
            </li>
            <li>Now and then it walks along its line before flying on; it flees when the pointer comes close</li>
            <li>The door shuts behind the bird; open it again and the bird flies home</li>
            <li>
              <code>walk</code>, <code>flight</code>: strips from <code>npm run sprites -w portfolio</code>
            </li>
            <li>Under reduced motion the door only opens</li>
          </ul>
          <div class="gutter-demo">
            <PixelFlight
              client:visible
              character="/assets/pixel-pigeon.jpg"
              walk="/assets/pixel-pigeon-walk.png"
              flight="/assets/pixel-pigeon-fly.png"
              still
              inset={false}
            />
          </div>
        </Specimen>

        <Specimen
          name="PixelBurrow"
          file="@tetiana/ui · PixelBurrow"
          usage={`<PixelBurrow client:visible character="/assets/pixel-beet.jpg" sprite="/assets/pixel-beet-walk.png" />`}
        >
          <ul slot="notes">
            <li>A PixelDoor whose character jumps down, carefully, and plants itself in the cell's bottom line</li>
            <li>
              It digs in until only its top shows, from the <code>eyes</code> up, and the door shuts behind it
            </li>
            <li>Open the door again: it sinks out of sight, comes out of the top line legs kicking, and drops in</li>
            <li>The cell is the nearest positioned ancestor: a frame gutter, with a row's lines above and below</li>
            <li>
              <code>sprite</code>: a four-frame leg strip, built by <code>npm run sprites -w portfolio</code>
            </li>
          </ul>
          <div class="burrow-demo">
            <PixelBurrow
              client:visible
              character="/assets/pixel-beet.jpg?v=2"
              sprite="/assets/pixel-beet-walk.png"
              still
            />
          </div>
        </Specimen>

        <Specimen
          name="PixelHang"
          file="@tetiana/ui · PixelHang"
          usage={`<PixelHang client:visible character="/assets/pixel-sloth.jpg" sprite="/assets/pixel-sloth-hang.png" />`}
        >
          <ul slot="notes">
            <li>A PixelDoor whose character lets itself down over the sill on one arm, very slowly</li>
            <li>Then it reaches up with the other arm and hangs from the door by both</li>
            <li>It falls asleep there, swaying, and the door shuts above it</li>
            <li>Open the door again: it wakes and climbs back in, just as slowly</li>
            <li>
              <code>sprite</code>: the character in layers, with arms that turn and stretch to keep hold of the sill
            </li>
            <li>
              <code>rig</code>: where its shoulders and claws are
            </li>
            <li>Needs a door's height of room below the door</li>
          </ul>
          <div class="hang-demo">
            <PixelHang
              client:visible
              character="/assets/pixel-sloth.jpg"
              sprite="/assets/pixel-sloth-hang.png"
              still
              inset={false}
            />
          </div>
        </Specimen>

        <Specimen
          name="PixelStage"
          file="@tetiana/ui · PixelStage"
          usage={`<PixelStage character="/assets/pixel-cat.jpg" motion={{ kind: "walk", sprite: "/assets/pixel-cat-walk.png" }} hint="Tap a door" />`}
        >
          <ul slot="notes">
            <li>Touch-first rail for the same characters when frame gutters collapse below 980px</li>
            <li>Reserves its own height, so doors and motion never cover capability copy</li>
            <li>Reuses walk, bow, burrow, hang and flight motion; the pigeon stays on perches inside the rail</li>
            <li>Scroll flapping is disabled; the character moves only after a deliberate tap</li>
            <li>An optional one-time hint makes the first door discoverable, then disappears after interaction</li>
          </ul>
          <PixelStage
            client:visible
            character="/assets/pixel-cat.jpg"
            motion={{ kind: "walk", sprite: "/assets/pixel-cat-walk.png" }}
            hint="Tap a door"
          />
        </Specimen>

        <Specimen
          name="AsciiVisual"
          file="@tetiana/ui · AsciiVisual"
          usage={`<AsciiVisual src="/assets/bookit-floorplan.jpg" focus="0.6 0.55" caption="BookIT / Floorplan editor" />`}
        >
          <ul slot="notes">
            <li>
              Redraws a screenshot as a coloured glyph mosaic; light UI is inverted so ink and colour carry the shape
            </li>
            <li>
              Resolves from noise on first view; the pointer opens a lens onto the real screenshot, with light glyphs
              still running over it
            </li>
            <li>
              <code>focus</code>: which part to keep when cropping
            </li>
          </ul>
          <div class="visual-demo">
            <AsciiVisual
              client:visible
              src="/assets/bookit-floorplan.jpg"
              focus="0.6 0.55"
              caption="BookIT / Floorplan editor"
            />
          </div>
        </Specimen>

        <Specimen
          name="SignalField"
          file="@tetiana/ui · SignalField"
          usage={`<SignalField tone="light" text="TetianaDovgalenko" />`}
        >
          <ul slot="notes">
            <li>
              <code>tone</code>: dark (light glyphs, hero) or light (dark glyphs, contact band)
            </li>
            <li>
              <code>text</code>: run a word on a loop instead of random glyphs
            </li>
            <li>
              <code>fade</code>, <code>top</code>, <code>opacity</code> for placement
            </li>
          </ul>
          <div class="field-demo" data-signal-host>
            <SignalField client:visible />
          </div>
          <div class="field-demo field-demo--light" data-signal-host>
            <SignalField client:visible tone="light" text="TetianaDovgalenko" opacity={0.65} />
          </div>
        </Specimen>

        <Specimen
          name="SkillGrid"
          file="@tetiana/ui · SkillGrid"
          usage={`<SkillGrid items={["Domain modelling", "Information architecture", …]} />`}
        >
          <p slot="notes">Three columns, then two compact columns on narrow screens. Cells invert on hover.</p>
          <div class="grid-demo">
            <SkillGrid items={["Domain modelling", "Information architecture", "Role-based workflows"]} />
          </div>
        </Specimen>

        <Specimen
          name="ContactPopup"
          file="@tetiana/ui · ContactPopup"
          usage={`<ContactPopup id="contact-links" title="Get in touch" links={contactLinks} />`}
        >
          <ul slot="notes">
            <li>The complete row is the action: email copies, external destinations open in a new tab.</li>
            <li>A compact tooltip follows the pointer and remains available on keyboard focus.</li>
            <li>On touch screens it becomes a bottom sheet with stacked details and inline copy feedback.</li>
            <li>
              Copy feedback changes from <code>Copy</code> to <code>Copied</code> or an error state.
            </li>
          </ul>
          <Button popoverTarget="system-contact-links">Get in touch</Button>
          <ContactPopup client:idle id="system-contact-links" title="Get in touch" links={contactLinks} />
        </Specimen>

        <FrameRow>
          <div class="patterns">
            <p class="text-label-m token-group">Layout & patterns</p>
            <dl>
              <div>
                <dt>Frame + FrameRow</dt>
                <dd>
                  The bordered container with gutter columns. Rows take a <code>gutter</code> slot and a{" "}
                  <code>divider</code> (top, none, bottom, both). Rows with column dividers close with a bottom line.
                </dd>
              </div>
              <div>
                <dt>SiteHeader + MobileNav</dt>
                <dd>
                  Language options move into a focus-managed mobile sheet; the sticky header hides on downward scroll
                  and returns on upward scroll. Case pages keep a compact back arrow and reading-progress line.
                </dd>
              </div>
              <div>
                <dt>CapabilityChapter</dt>
                <dd>Tile + chapter title + intro; groups capability blocks.</dd>
              </div>
              <div>
                <dt>CapabilityBlock</dt>
                <dd>
                  Door + title + statement, copy with proof Button, AsciiVisual, SkillGrid. Content comes from{" "}
                  <code>src/data/capabilities.js</code>; <code>flip</code> alternates.
                </dd>
              </div>
              <div>
                <dt>Case pages</dt>
                <dd>
                  Each case is an MDX file in <code>src/content/cases</code>. Frontmatter feeds CaseHero (title,
                  summary, tags, StatRow and AsciiVisual cover); the body composes Section, Shot, Shots, Video,
                  Research, More, Cards, Principle, Contrast, Terms, Tags, Steps, Checks and Note (an aside, or{" "}
                  <code>variant="notice"</code> for a framed alert about the demo). Built on Figure, Lightbox, StatRow,
                  InfoCard, TermGrid, TagList, Clip, StepList, Checklist and MediaRow from @tetiana/ui. Mobile cases add
                  a collapsible section index, scroll-snap screenshot sequences and explicit zoom and copy controls.
                </dd>
              </div>
              <div>
                <dt>ContactBand</dt>
                <dd>Inverse band with a light SignalField, heading-1 and a dark Button that opens ContactPopup.</dd>
              </div>
            </dl>
          </div>
        </FrameRow>
      </DocSection>
      <div class="end-space"></div>
    </Frame>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .system {
    padding-top: calc(var(--layout-header-height) + 2 * var(--space-page));
  }

  .intro {
    padding: var(--space-inset) var(--space-inset-inline);
  }

  .intro > .text-label-l,
  .token-group {
    margin: 0 0 1.4rem;
    color: var(--color-text-muted);
  }

  .intro-lead {
    max-width: 40rem;
    margin: var(--space-xl) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--font-line-height-relaxed);
  }

  .intro-actions {
    margin-top: var(--space-2xl);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .toc a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc a:hover {
