{
  "$description": "Component tokens: the decisions one component makes. They point at semantic tokens, or hold sizes that belong to a single component.",
  "button": {
    "light": {
      "$type": "color",
      "bg": {
        "$value": "{color.surface.inverse}",
        "$description": "Also the border, so the button keeps its size on hover."
      },
      "fg": { "$value": "{color.text.inverse}" },
      "bg-hover": { "$value": "{color.surface.page}" },
      "fg-hover": { "$value": "{color.text.primary}" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "{color.surface.page}" },
      "fg": { "$value": "{color.text.primary}" },
      "bg-hover": { "$value": "{color.surface.inverse}" },
      "fg-hover": { "$value": "{color.text.inverse}" }
    },
    "text": {
      "fg": { "$type": "color", "$value": "{color.text.muted}" },
      "fg-hover": { "$type": "color", "$value": "{color.text.primary}" },
      "font-size": { "$type": "dimension", "$value": "0.95rem" }
    },
    "m": {
      "$type": "dimension",
      "height": { "$value": "3.25rem" },
      "gap": { "$value": "1.1rem" },
      "padding-inline": { "$value": "1.4rem" },
      "font-size": { "$value": "clamp(1rem, 1.25vw, 1.15rem)" }
    },
    "s": {
      "$type": "dimension",
      "height": { "$value": "3rem" },
      "gap": { "$value": "0.9rem" },
      "padding-inline": { "$value": "1.3rem" },
      "font-size": { "$value": "{font.size.body-s}" }
    }
  },
  "tile": {
    "bg": { "$type": "color", "$value": "{color.surface.inverse}" },
    "fg": { "$type": "color", "$value": "{color.text.inverse}" },
    "font-size": {
      "$type": "dimension",
      "$value": "clamp(1.6rem, 3.4vw, 3.4rem)",
      "$description": "Pixel letter in the tile."
    }
  },
  "door": {
    "$type": "color",
    "bg": { "$value": "{color.surface.void}", "$description": "The dark opening behind the leaf." },
    "edge": { "$value": "{color.border.subtle}", "$description": "Hairline around the door leaf." },
    "light-opacity": {
      "$type": "number",
      "$value": 0.35,
      "$description": "A restrained hint of warm light while the door is ajar."
    }
  },
  "mobile-nav": {
    "trigger-size": {
      "$type": "dimension",
      "$value": "3rem",
      "$description": "Square touch target for the compact navigation trigger."
    },
    "item-min-height": {
      "$type": "dimension",
      "$value": "3.75rem",
      "$description": "Minimum touch-friendly height of a link in the compact navigation panel."
    }
  },
  "hero": {
    "mobile-title-cap": {
      "$type": "dimension",
      "$value": "9.3cqi",
      "$description": "Maximum title size relative to the narrow light hero card, keeping each authored statement on one line."
    }
  },
  "footer-dock": {
    "$description": "Floating mobile-only dock with dimensional app-style contact icons.",
    "surface": { "$type": "color", "$value": "{color.surface.header}" },
    "border": { "$type": "color", "$value": "{color.border.subtle}" },
    "shadow": { "$type": "color", "$value": "{color.surface.void}" },
    "shine": { "$type": "color", "$value": "{color.border.default}" },
    "glyph": { "$type": "color", "$value": "{color.text.primary}" },
    "email-start": { "$type": "color", "$value": "{color.light.core}" },
    "email-end": { "$type": "color", "$value": "{color.light.ember}" },
    "linkedin-start": { "$type": "color", "$value": "{color.text.primary}" },
    "linkedin-end": { "$type": "color", "$value": "{color.accent.default}" },
    "github-start": { "$type": "color", "$value": "{color.text.secondary}" },
    "github-end": { "$type": "color", "$value": "{color.text.muted}" },
    "document-start": { "$type": "color", "$value": "{color.light.warm}" },
    "document-end": { "$type": "color", "$value": "{color.light.ember}" },
    "top-start": { "$type": "color", "$value": "{color.text.primary}" },
    "top-end": { "$type": "color", "$value": "{color.accent.default}" },
    "size": { "$type": "dimension", "$value": "3rem" },
    "glyph-size": { "$type": "dimension", "$value": "1.75rem" },
    "surface-radius": { "$type": "dimension", "$value": "0.375rem" },
    "padding": { "$type": "dimension", "$value": "0.5rem" },
    "gap": { "$type": "dimension", "$value": "0.5rem" },
    "offset": { "$type": "dimension", "$value": "1rem" },
    "border-width": { "$type": "dimension", "$value": "0.0625rem" },
    "depth": { "$type": "dimension", "$value": "0.25rem" },
    "shadow-y": { "$type": "dimension", "$value": "0.5rem" },
    "shadow-blur": { "$type": "dimension", "$value": "1.5rem" },
    "glass-blur": { "$type": "dimension", "$value": "1.25rem" },
    "glass-saturation": { "$type": "number", "$value": 1.45 },
    "surface-opacity": { "$type": "dimension", "$value": "26%" },
    "glow-angle": { "$type": "dimension", "$value": "135deg" },
    "glow-stop": { "$type": "dimension", "$value": "42%" },
    "icon-stroke-width": { "$type": "number", "$value": 1.7 },
    "icon-shadow-y": { "$type": "dimension", "$value": "0.125rem" },
    "icon-shadow-blur": { "$type": "dimension", "$value": "0.25rem" },
    "icon-hover-brightness": { "$type": "number", "$value": 1.12 },
    "icon-hover-saturation": { "$type": "number", "$value": 1.12 },
    "icon-hover-scale": { "$type": "number", "$value": 1.08 },
    "icon-active-scale": { "$type": "number", "$value": 0.94 }
  },
  "pixel-stage": {
    "height": {
      "$type": "dimension",
      "$value": "clamp(7.5rem, 22vw, 10rem)",
      "$description": "Reserved mobile and tablet rail for a door and its character animation."
    },
    "door-size": {
      "$type": "dimension",
      "$value": "clamp(3.75rem, 12vw, 5.5rem)",
      "$description": "Touch-friendly door size inside the compact character rail."
    }
  },
  "tag": {
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "fg": { "$type": "color", "$value": "{color.text.secondary}" },
    "bg-hover": { "$type": "color", "$value": "{color.surface.inverse}", "$description": "Tags that link somewhere." },
    "fg-hover": { "$type": "color", "$value": "{color.text.inverse}" },
    "padding-block": { "$type": "dimension", "$value": "0.55rem" },
    "padding-inline": { "$type": "dimension", "$value": "{space.xs}" },
    "gap": { "$type": "dimension", "$value": "{space.2xs}", "$description": "Space between tags in a list." }
  },
  "note": {
    "$type": "color",
    "marker": { "$value": "{color.accent.default}", "$description": "Short rule above a margin note, and its label." },
    "fg": { "$value": "{color.text.muted}" }
  },
  "notice": {
    "$type": "color",
    "bg": { "$value": "{color.surface.raised}", "$description": "Panel behind a notice about the demo or its limits." },
    "border": { "$value": "{color.border.subtle}" },
    "marker": { "$value": "{color.accent.default}", "$description": "Leading rule, icon and label of a notice." },
    "fg": { "$value": "{color.text.secondary}" }
  },
  "skill": {
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "bg-hover": { "$type": "color", "$value": "{color.surface.inverse}" },
    "fg-hover": { "$type": "color", "$value": "{color.text.inverse}" },
    "reveal-glow": {
      "$type": "color",
      "$value": "{color.border.subtle}",
      "$description": "Delicate light that passes through a skill while it is revealed on touch layouts."
    },
    "reveal-offset": { "$type": "dimension", "$value": "{space.2xs}" },
    "reveal-stagger": { "$type": "duration", "$value": "{duration.fast}" },
    "font-size": { "$type": "dimension", "$value": "clamp(1.05rem, 1.45vw, 1.35rem)" },
    "min-height": { "$type": "dimension", "$value": "clamp(8rem, 11vw, 10.5rem)" }
  }
}
