{
  "name": "@tetiana/ui",
  "version": "0.1.0",
  "description": "React + TypeScript components for the Tetiana Dovgalenko design system.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
